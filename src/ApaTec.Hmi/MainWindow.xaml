<Window x:Class="ApaTec.Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ApaTec.Hmi.ViewModels"
        xmlns:res="clr-namespace:ApaTec.Hmi.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel, IsDesignTimeCreatable=True}"
        Title="{res:Loc App_Title}"
        Width="{StaticResource Size.Window.Width}"
        Height="{StaticResource Size.Window.Height}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource Font.Family.Default}"
        FontSize="{StaticResource Font.Size.Body}">

    <Window.Resources>
        <!-- Header und Inhalt ueberspannen im Vollbild (HS-24, ShowFrame = false) die volle Fensterbreite; der Inhalt auch die Zeilen darunter. -->
        <!-- Lage steht im Stil (nicht lokal am Element), sonst koennten die Trigger sie nicht ueberschreiben. -->
        <Style x:Key="Shell.HeaderHost" TargetType="ContentControl" BasedOn="{StaticResource Frame.Placeholder}">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowFrame}" Value="False">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Shell.ContentHost" TargetType="ContentControl">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowFrame}" Value="False">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.RowSpan" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pop-up-Ebene: Scrim ueber dem ganzen Fenster, Pop-up mittig; leer = nicht sichtbar. -->
        <Style x:Key="Shell.PopupHost" TargetType="ContentControl">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid x:Name="Layer" Background="{DynamicResource Brush.Scrim}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Layer" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Rahmen-Grid nach Designsystem 3.2: Spalten 3* : 37*, Zeilen im Arbeitsbereich 4* : 3* : 34* : 4*. Keine festen Pixelpositionen. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Size.Sidebar.Width}" />
            <ColumnDefinition Width="{StaticResource Size.Workspace.Width}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Size.Header.Height}" />
            <RowDefinition Height="{StaticResource Size.Crumb.Height}" />
            <RowDefinition Height="{StaticResource Size.Content.Height}" />
            <RowDefinition Height="{StaticResource Size.FunctionBar.Height}" />
        </Grid.RowDefinitions>

        <!-- Seitenleiste (HM-01), volle Hoehe. Erweiterungspunkt: ContentControl durch <controls:HM01_Sidebar .../> ersetzen. -->
        <ContentControl x:Name="SidebarHost"
                        Grid.Column="0" Grid.Row="0" Grid.RowSpan="4"
                        Style="{StaticResource Frame.Placeholder}"
                        Background="{DynamicResource Brush.Sidebar}"
                        Foreground="{DynamicResource Brush.Sidebar.Text.Secondary}"
                        Tag="{res:Loc Frame_Sidebar_Placeholder}"
                        Visibility="{Binding ShowFrame, Converter={StaticResource BooleanToVisibility}}" />

        <!-- Kopfzeile (HM-02 mit Meldezeile HM-03): Spalten Logo / Meldezeile / Betriebsart / Uhr = Size.Header.Col.* (12* : 13* : 6* : 4*) liegen im Modul. -->
        <ContentControl x:Name="HeaderHost"
                        Style="{StaticResource Shell.HeaderHost}"
                        Tag="{res:Loc Frame_Header_Placeholder}" />

        <!-- Brotkruemel (HM-04) und Kennzahlen Geschwindigkeit/Winkel (HM-05): Spalten Size.Crumb.Col.* (56* : 10* : 10*). -->
        <Grid Grid.Column="1" Grid.Row="1"
              Visibility="{Binding ShowFrame, Converter={StaticResource BooleanToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource Size.Crumb.Col.Path}" />
                <ColumnDefinition Width="{StaticResource Size.Crumb.Col.Speed}" />
                <ColumnDefinition Width="{StaticResource Size.Crumb.Col.Angle}" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="BreadcrumbHost" Grid.Column="0"
                            Style="{StaticResource Frame.Placeholder}"
                            Tag="{res:Loc Frame_Breadcrumb_Placeholder}" />
            <ContentControl x:Name="SpeedHost" Grid.Column="1"
                            Style="{StaticResource Frame.Placeholder}"
                            Tag="{res:Loc Frame_Speed_Placeholder}" />
            <ContentControl x:Name="AngleHost" Grid.Column="2"
                            Style="{StaticResource Frame.Placeholder}"
                            Tag="{res:Loc Frame_Angle_Placeholder}" />
        </Grid>

        <!-- Inhaltsbereich: zeigt das aktuelle Seiten-ViewModel; die View kommt per ViewLocator (Namenskonvention). -->
        <ContentControl x:Name="ContentHost"
                        Style="{StaticResource Shell.ContentHost}"
                        Margin="{StaticResource Size.Content.Margin}"
                        Content="{Binding CurrentPage}"
                        ContentTemplateSelector="{StaticResource ViewLocator}" />

        <!-- Untere Funktionsleiste (HM-06); die Tasten liefert das Seiten-ViewModel (FunctionBarItems). -->
        <ContentControl x:Name="FunctionBarHost"
                        Grid.Column="1" Grid.Row="3"
                        Style="{StaticResource Frame.Placeholder}"
                        Tag="{res:Loc Frame_FunctionBar_Placeholder}"
                        Visibility="{Binding ShowFrame, Converter={StaticResource BooleanToVisibility}}" />

        <!-- Pop-up-Ebene mit Scrim, Inhalt per ViewLocator. -->
        <ContentControl x:Name="PopupHost"
                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="4"
                        Style="{StaticResource Shell.PopupHost}"
                        Content="{Binding CurrentPopup}"
                        ContentTemplateSelector="{StaticResource ViewLocator}" />
    </Grid>
</Window>
