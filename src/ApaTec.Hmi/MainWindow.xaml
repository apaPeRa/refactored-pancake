<Window x:Class="ApaTec.Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ApaTec.Hmi.ViewModels"
        xmlns:res="clr-namespace:ApaTec.Hmi.Resources"
        xmlns:controls="clr-namespace:ApaTec.Hmi.Controls"
        xmlns:nav="clr-namespace:ApaTec.Hmi.Navigation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel, IsDesignTimeCreatable=True}"
        Title="{res:Loc App_Title}"
        Width="{StaticResource Size.Window.Width}"
        Height="{StaticResource Size.Window.Height}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource Font.Family.Default}"
        FontSize="{StaticResource Font.Size.Body}">

    <Window.Resources>
        <!-- Header und Inhalt ueberspannen im Vollbild (HS-24, ShowFrame = false) die volle Fensterbreite; der Inhalt auch die Zeilen darunter. -->
        <!-- Lage steht im Stil (nicht lokal am Element), sonst koennten die Trigger sie nicht ueberschreiben. -->
        <Style x:Key="Shell.HeaderHost" TargetType="controls:HM02_HeaderBar" BasedOn="{StaticResource {x:Type controls:HM02_HeaderBar}}">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowFrame}" Value="False">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Inhaltsbereich: Scrollbereich (S-01, A-102). Die Seite bekommt mindestens die sichtbare Hoehe (Stern-Zeilen fuellen sie), ist sie hoeher, erscheint die themenkonforme Scrollleiste. -->
        <Style x:Key="Shell.ContentScroll" TargetType="ScrollViewer">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="2" />
            <Setter Property="Padding" Value="{StaticResource Size.Content.Margin}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowFrame}" Value="False">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.RowSpan" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pop-up-Ebene: Scrim ueber dem ganzen Fenster, Pop-up mittig; leer = nicht sichtbar. -->
        <Style x:Key="Shell.PopupHost" TargetType="ContentControl">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid x:Name="Layer" Background="{DynamicResource Brush.Scrim}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Layer" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Rahmen-Grid nach Designsystem 3.2: Spalten 3* : 37*; Zeilen Kopf/Brotkruemel/Funktionsleiste in festen Hoehen (Tokens, A-102), Inhalt *. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Size.Sidebar.Width}" />
            <ColumnDefinition Width="{StaticResource Size.Workspace.Width}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Size.Header.Height}" />
            <RowDefinition Height="{StaticResource Size.Crumb.Height}" />
            <RowDefinition Height="{StaticResource Size.Content.Height}" />
            <RowDefinition Height="{StaticResource Size.FunctionBar.Height}" />
        </Grid.RowDefinitions>

        <!-- Seitenleiste (HM-01), volle Hoehe. Hinter Pop-ups gesperrt (IsFrameInteractive), im Vollbild (HS-24) ausgeblendet. -->
        <controls:HM01_Sidebar x:Name="SidebarHost"
                               Grid.Column="0" Grid.Row="0" Grid.RowSpan="4"
                               Visibility="{Binding ShowFrame, Converter={StaticResource BooleanToVisibility}}"
                               IsEnabled="{Binding IsFrameInteractive}"
                               Initials="{Binding UserInitials}"
                               UserName="{Binding UserName}"
                               UserRole="{Binding UserRoleText}"
                               IsLoggedIn="{Binding IsLoggedIn}"
                               Items="{Binding SidebarItems}"
                               CurrentItemId="{Binding CurrentSidebarItemId}"
                               UnreadMessageCount="{Binding UnreadMessageCount}"
                               CanGoBack="{Binding CanGoBack}"
                               NavigateCommand="{Binding SidebarNavigateCommand}"
                               BackCommand="{Binding BackCommand}"
                               UserCommand="{Binding UserCommand}" />

        <!-- Kopfzeile (HM-02 mit Meldezeile HM-03): Spalten Logo / Meldezeile / Betriebsart / Uhr = Size.Header.Col.* (12* : 13* : 6* : 4*) liegen im Modul. Anzeige, kein Sperrzustand noetig (Scrim). -->
        <controls:HM02_HeaderBar x:Name="HeaderHost"
                                 Style="{StaticResource Shell.HeaderHost}"
                                 OperatingMode="{Binding OperatingMode}"
                                 OperatingModeText="{Binding OperatingModeText}"
                                 Now="{Binding Now}"
                                 ShowMessageLine="{Binding ShowMessageLine}"
                                 MessageNumber="{Binding MessageNumber}"
                                 MessageText="{Binding MessageText}"
                                 MessageClass="{Binding MessageClass}"
                                 AdditionalMessageCount="{Binding AdditionalMessageCount}"
                                 MessageCommand="{Binding MessagesCommand}" />

        <!-- Brotkruemel (HM-04) und Kennzahlen Geschwindigkeit/Winkel (HM-05): Spalten Size.Crumb.Col.* (56* : 10* : 10*). -->
        <Grid Grid.Column="1" Grid.Row="1"
              Visibility="{Binding ShowFrame, Converter={StaticResource BooleanToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource Size.Crumb.Col.Path}" />
                <ColumnDefinition Width="{StaticResource Size.Crumb.Col.Speed}" />
                <ColumnDefinition Width="{StaticResource Size.Crumb.Col.Angle}" />
            </Grid.ColumnDefinitions>
            <controls:HM04_Breadcrumb x:Name="BreadcrumbHost" Grid.Column="0"
                                      IsEnabled="{Binding IsFrameInteractive}"
                                      Segments="{Binding Breadcrumb}"
                                      NavigateCommand="{Binding NavigateToAncestorCommand}" />
            <!-- Geschwindigkeit: antippbar, oeffnet HS-03 (Navigation.md 3.2); hinter Pop-ups gesperrt -->
            <controls:HM05_MetricTile x:Name="SpeedHost" Grid.Column="1"
                                      Margin="{StaticResource Inset.Frame.Tile}"
                                      TileSize="Frame"
                                      Icon="{StaticResource Icon.Speed}"
                                      Unit="{res:Loc HM05_Unit_Speed}"
                                      AutomationProperties.Name="{res:Loc HM05_Speed_Automation}"
                                      Value="{Binding MachineSpeed}"
                                      IsInteractive="True"
                                      IsEnabled="{Binding IsFrameInteractive}"
                                      OpenCommand="{Binding NavigateCommand}"
                                      CommandParameter="{x:Static nav:PageKeys.MachineSpeed}" />
            <!-- Maschinenwinkel: nur Anzeige -->
            <controls:HM05_MetricTile x:Name="AngleHost" Grid.Column="2"
                                      Margin="{StaticResource Inset.Frame.Tile.End}"
                                      TileSize="Frame"
                                      Icon="{StaticResource Icon.Angle}"
                                      Unit="{res:Loc HM05_Unit_Angle}"
                                      AutomationProperties.Name="{res:Loc HM05_Angle_Automation}"
                                      Value="{Binding MachineAngle}" />
        </Grid>

        <!-- Inhaltsbereich: zeigt das aktuelle Seiten-ViewModel; die View kommt per ViewLocator (Namenskonvention). -->
        <ScrollViewer x:Name="ContentScroll" Style="{StaticResource Shell.ContentScroll}">
            <ContentControl x:Name="ContentHost"
                            IsTabStop="False"
                            MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            Content="{Binding CurrentPage}"
                            ContentTemplateSelector="{StaticResource ViewLocator}" />
        </ScrollViewer>

        <!-- Untere Funktionsleiste (HM-06); die Tasten liefert das Seiten-ViewModel (FunctionBarItems). Hinter Pop-ups gesperrt, bleibt sichtbar. -->
        <controls:HM06_FunctionBar x:Name="FunctionBarHost"
                                   Grid.Column="1" Grid.Row="3"
                                   Visibility="{Binding ShowFrame, Converter={StaticResource BooleanToVisibility}}"
                                   IsEnabled="{Binding IsFrameInteractive}"
                                   Items="{Binding FunctionBarItems}"
                                   CurrentTargetId="{Binding CurrentPageKey}" />

        <!-- Pop-up-Ebene mit Scrim, Inhalt per ViewLocator. -->
        <ContentControl x:Name="PopupHost"
                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="4"
                        Style="{StaticResource Shell.PopupHost}"
                        Content="{Binding CurrentPopup}"
                        ContentTemplateSelector="{StaticResource ViewLocator}" />
    </Grid>
</Window>
