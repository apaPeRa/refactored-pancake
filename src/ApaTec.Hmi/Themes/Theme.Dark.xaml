  <SolidColorBrush x:Key="Brush.Status.Info.Subtle" Color="#16304A" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Inactive.Fill" Color="#9AA4B1" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Inactive.On" Color="#141A21" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Inactive.Fg" Color="#9AA4B1" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Graphic.Carton" Color="#8A6A4F" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Graphic.Outline" Color="#E8EDF2" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Graphic.Glue" Color="#F0E2B8" po:Freeze="True" />
</ResourceDictionary>
