<?xml version="1.0" encoding="utf-8"?>
<!-- Controls.Base.xaml: Basisstile (Textstile, Standardtaste ohne 3D/Verlauf, Fokusvisual: 3 px Rahmen Brush.Border.Focus statt gepunktetem Standardrechteck). Flach nach Designsystem.md 4, 5 und 7.
     Farben nur per DynamicResource (Brush.*), Masse und Schriften per StaticResource aus Tokens.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Textstile (Designsystem 2) -->
  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}" />
    <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Regular}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />
  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style x:Key="Text.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Value}" />
    <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Strong}" />
  </Style>
  <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Title}" />
    <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Strong}" />
  </Style>
  <Style x:Key="Text.Metric" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Metric}" />
    <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Strong}" />
  </Style>
  <Style x:Key="Text.Disabled" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
  </Style>

  <!-- Standardtaste (Designsystem 5 und 7): flach, 64 px hoch, Zustaende Normal, Gedrueckt, Deaktiviert (gestrichelt), Fokus -->
  <Style TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}" />
    <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Regular}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Button.Normal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.Button.MinWidth}" />
    <Setter Property="Padding" Value="{StaticResource Inset.Button}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Face"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Control}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Border>
            <!-- Zweiter Kanal fuer Deaktiviert: gestrichelte Kontur (nur sichtbar im Zustand deaktiviert) -->
            <Rectangle x:Name="DisabledDash"
                       Visibility="Collapsed"
                       RadiusX="{StaticResource Radius.Control.Size}" RadiusY="{StaticResource Radius.Control.Size}"
                       Stroke="{DynamicResource Brush.Border.Control}"
                       StrokeThickness="{StaticResource Border.Thin.Size}"
                       StrokeDashArray="{StaticResource Border.Dash}" />
            <!-- Fokus: 3 px Rahmen (Form als zweiter Kanal) -->
            <Border x:Name="FocusRing"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                    BorderThickness="{StaticResource Border.Thick}"
                    CornerRadius="{StaticResource Radius.Control}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Pressed}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Disabled}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="DisabledDash" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Platzhalter fuer Rahmenbereiche des Hauptfensters (M2-04 ersetzt sie durch die Module HM-01 bis HM-06).
       Tag = Beschriftung des Platzhalters (Ressourcentext), Background/BorderBrush kommen von der Verwendung. -->
  <Style x:Key="Frame.Placeholder" TargetType="ContentControl">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Brush.Divider}"
                  BorderThickness="{StaticResource Border.Thin}">
            <TextBlock Style="{StaticResource Text.Caption}"
                       Foreground="{TemplateBinding Foreground}"
                       Text="{TemplateBinding Tag}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
