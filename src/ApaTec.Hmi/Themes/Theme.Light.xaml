<?xml version="1.0" encoding="utf-8"?>
<!-- Theme.Light.xaml (Hellthema): themenabhaengige Farbtokens (Designsystem.md 10.1). Identische Schluessel in Theme.Light.xaml und Theme.Dark.xaml.
     Verwendung nur ueber {DynamicResource Brush.*}, sonst wirkt die Laufzeitumschaltung nicht. Keine Hex-Werte ausserhalb dieser Dateien. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">
  <SolidColorBrush x:Key="Brush.Window" Color="#EEF1F4" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="#E3E8ED" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Divider" Color="#C5CCD5" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Border.Control" Color="#6B7480" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Border.Focus" Color="#1565C0" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1A222C" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#4A5563" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#6B7480" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Text.OnActive" Color="#FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#2B3846" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Sidebar.Text" Color="#FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Sidebar.Text.Secondary" Color="#C9D3DE" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Sidebar.Selected" Color="#3F5066" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Button.Normal" Color="#DCE1E7" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Button.Pressed" Color="#C3CBD5" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Button.Disabled" Color="#FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Button.Active" Color="#2B3846" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Progress.Fill" Color="#4A5563" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Scrim" Color="#80000000" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Ok.Fill" Color="#187228" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Ok.On" Color="#FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Ok.Fg" Color="#187228" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Ok.Subtle" Color="#E4F4E7" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Warning.Fill" Color="#F2B600" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Warning.On" Color="#1A222C" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Warning.Fg" Color="#8A5A00" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Warning.Subtle" Color="#FFF4CC" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Error.Fill" Color="#C62828" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Error.On" Color="#FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Error.Fg" Color="#C62828" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Error.Subtle" Color="#FDECEC" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Info.Fill" Color="#1565C0" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Info.On" Color="#FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Info.Fg" Color="#1565C0" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Info.Subtle" Color="#E3F0FD" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Inactive.Fill" Color="#5F6975" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Inactive.On" Color="#FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Status.Inactive.Fg" Color="#5F6975" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Graphic.Carton" Color="#B07A52" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Graphic.Outline" Color="#1A222C" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Graphic.Glue" Color="#FBF0D0" po:Freeze="True" />
</ResourceDictionary>
