<UserControl x:Class="ApaTec.Hmi.Views.CheckWeigherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ApaTec.Hmi.ViewModels"
             xmlns:controls="clr-namespace:ApaTec.Hmi.Controls"
             xmlns:res="clr-namespace:ApaTec.Hmi.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CheckWeigherViewModel, IsDesignTimeCreatable=True}">
    <!-- HS-13 Kontrollwaage: fuenf Gruppen untereinander (Zeilen 4* : 3* : 3* : 4,5* : 3*), je 12-Spalten-Raster. Reihenfolge nach der Leserichtung der Referenz. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="4*" />
      <RowDefinition Height="3*" />
      <RowDefinition Height="3*" />
      <RowDefinition Height="4.5*" />
      <RowDefinition Height="3*" />
    </Grid.RowDefinitions>
    <controls:HM15_GroupPanel Grid.Row="0" GroupStyle="Heading" Header="{res:Loc HS13_Group_Weight_Label}">
      <Grid>
        <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:HM05_MetricTile Grid.Column="0" Grid.ColumnSpan="4" Margin="{StaticResource Inset.S}" Icon="{StaticResource Icon.Weight.Scale}"
                                  Label="{res:Loc HS13_Net_Label}" Value="{Binding Net}" Unit="{res:Loc HS13_Unit_Gram}" StringFormat="N1" />
        <controls:HM05_MetricTile Grid.Column="4" Grid.ColumnSpan="3" Margin="{StaticResource Inset.S}" Icon="{StaticResource Icon.Weight.Scale}"
                                  Label="{res:Loc HS13_Gross_Label}" Value="{Binding Gross}" Unit="{res:Loc HS13_Unit_Gram}" StringFormat="N1" />
        <controls:HM05_MetricTile Grid.Column="7" Grid.ColumnSpan="3" Margin="{StaticResource Inset.S}" Icon="{StaticResource Icon.Weight.Scale}"
                                  Label="{res:Loc HS13_Live_Label}" Value="{Binding Live}" Unit="{res:Loc HS13_Unit_Gram}" StringFormat="N1" />
        <controls:HM07_ActionButton Grid.Column="10" Grid.ColumnSpan="2" Margin="{StaticResource Inset.S}" VerticalAlignment="Center"
                                    Label="{res:Loc HS13_SetZero_Label}" Command="{Binding SetZeroCommand}"
                                    RequiresPermission="True" IsAuthorized="{Binding IsAuthorized}" />
      </Grid>
    </controls:HM15_GroupPanel>
    <controls:HM15_GroupPanel Grid.Row="1" GroupStyle="Heading" Header="{res:Loc HS13_Group_Statistics_Label}">
      <Grid>
        <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:HM05_MetricTile Grid.Column="0" Grid.ColumnSpan="4" Margin="{StaticResource Inset.S}" Icon="{StaticResource Icon.Stat.Mean}"
                                  Label="{res:Loc HS13_Mean_Label}" Value="{Binding Mean}" Unit="{res:Loc HS13_Unit_Gram}" StringFormat="N1" />
        <controls:HM05_MetricTile Grid.Column="4" Grid.ColumnSpan="4" Margin="{StaticResource Inset.S}" Icon="{StaticResource Icon.Stat.StdDev}"
                                  Label="{res:Loc HS13_StdDev_Label}" Value="{Binding StdDev}" Unit="{res:Loc HS13_Unit_Gram}" StringFormat="N1" />
        <controls:HM05_MetricTile Grid.Column="8" Grid.ColumnSpan="4" Margin="{StaticResource Inset.S}" Icon="{StaticResource Icon.Speed}"
                                  Label="{res:Loc HS13_Performance_Label}" Value="{Binding Performance}" Unit="{res:Loc HS13_Unit_PerMin}" StringFormat="N1" />
      </Grid>
    </controls:HM15_GroupPanel>
    <controls:HM15_GroupPanel Grid.Row="2" GroupStyle="Heading" Header="{res:Loc HS13_Group_WeighParams_Label}">
      <Grid>
        <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:HM12_ValueInput Grid.Column="0" Grid.ColumnSpan="4" Margin="{StaticResource Inset.S}" VerticalAlignment="Top"
                                DataContext="{Binding TargetWeight}"
                                Icon="{StaticResource Icon.Pack.Target}"
                                Label="{Binding Label}" NumberValue="{Binding Value}" Unit="{Binding Unit}" Decimals="{Binding Decimals}"
                                Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                RequiresPermission="True" IsAuthorized="{Binding IsAuthorized}" RequiredRole="{Binding RequiredRole}"
                                ErrorText="{Binding ErrorText}" IsEditing="{Binding IsEditing}"
                                Command="{Binding EditCommand}" />
        <controls:HM12_ValueInput Grid.Column="4" Grid.ColumnSpan="4" Margin="{StaticResource Inset.S}" VerticalAlignment="Top"
                                DataContext="{Binding Tare}"
                                Icon="{StaticResource Icon.Pack.Tare}"
                                Label="{Binding Label}" NumberValue="{Binding Value}" Unit="{Binding Unit}" Decimals="{Binding Decimals}"
                                Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                RequiresPermission="True" IsAuthorized="{Binding IsAuthorized}" RequiredRole="{Binding RequiredRole}"
                                ErrorText="{Binding ErrorText}" IsEditing="{Binding IsEditing}"
                                Command="{Binding EditCommand}" />
        <controls:HM12_ValueInput Grid.Column="8" Grid.ColumnSpan="4" Margin="{StaticResource Inset.S}" VerticalAlignment="Top"
                                DataContext="{Binding AutoZero}"
                                Icon="{StaticResource Icon.Weight.AutoZero}"
                                Label="{Binding Label}" NumberValue="{Binding Value}" Unit="{Binding Unit}" Decimals="{Binding Decimals}"
                                Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                RequiresPermission="True" IsAuthorized="{Binding IsAuthorized}" RequiredRole="{Binding RequiredRole}"
                                ErrorText="{Binding ErrorText}" IsEditing="{Binding IsEditing}"
                                Counter="{Binding Counter}"
                                Command="{Binding EditCommand}" />
      </Grid>
    </controls:HM15_GroupPanel>
    <controls:HM15_GroupPanel Grid.Row="3" GroupStyle="Heading" Header="{res:Loc HS13_Group_Limits_Label}">
      <Grid>
        <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:HM12_ValueInput Grid.Column="0" Grid.ColumnSpan="4" Margin="{StaticResource Inset.S}" VerticalAlignment="Top"
                                DataContext="{Binding OverWeight}"
                                Icon="{StaticResource Icon.Pack.Over}"
                                Label="{Binding Label}" NumberValue="{Binding Value}" Unit="{Binding Unit}" Decimals="{Binding Decimals}"
                                Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                RequiresPermission="True" IsAuthorized="{Binding IsAuthorized}" RequiredRole="{Binding RequiredRole}"
                                ErrorText="{Binding ErrorText}" IsEditing="{Binding IsEditing}"
                                CoupledCounter="{Binding CoupledCounter}"
                                Command="{Binding EditCommand}" />
        <controls:HM12_ValueInput Grid.Column="4" Grid.ColumnSpan="4" Margin="{StaticResource Inset.S}" VerticalAlignment="Top"
                                DataContext="{Binding Under1}"
                                Icon="{StaticResource Icon.Pack.Present}"
                                Label="{Binding Label}" NumberValue="{Binding Value}" Unit="{Binding Unit}" Decimals="{Binding Decimals}"
                                Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                RequiresPermission="True" IsAuthorized="{Binding IsAuthorized}" RequiredRole="{Binding RequiredRole}"
                                ErrorText="{Binding ErrorText}" IsEditing="{Binding IsEditing}"
                                CoupledCounter="{Binding CoupledCounter}"
                                Command="{Binding EditCommand}" />
        <controls:HM12_ValueInput Grid.Column="8" Grid.ColumnSpan="4" Margin="{StaticResource Inset.S}" VerticalAlignment="Top"
                                DataContext="{Binding Under2}"
                                Icon="{StaticResource Icon.Pack.Present}"
                                Label="{Binding Label}" NumberValue="{Binding Value}" Unit="{Binding Unit}" Decimals="{Binding Decimals}"
                                Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                RequiresPermission="True" IsAuthorized="{Binding IsAuthorized}" RequiredRole="{Binding RequiredRole}"
                                ErrorText="{Binding ErrorText}" IsEditing="{Binding IsEditing}"
                                CoupledCounter="{Binding CoupledCounter}"
                                Command="{Binding EditCommand}" />
      </Grid>
    </controls:HM15_GroupPanel>
    <controls:HM15_GroupPanel Grid.Row="4" GroupStyle="Heading" Header="{res:Loc HS13_Group_Counters_Label}">
      <Grid>
        <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:HM05_MetricTile Grid.Column="0" Grid.ColumnSpan="3" Margin="{StaticResource Inset.S}" Icon="{StaticResource Icon.Status.Ok}"
                                  Label="{res:Loc HS13_Good_Label}" Value="{Binding GoodCount}" StringFormat="N0" />
        <controls:HM05_MetricTile Grid.Column="3" Grid.ColumnSpan="3" Margin="{StaticResource Inset.S}"
                                  Label="{res:Loc HS13_Under1Percent_Label}" Value="{Binding Under1Percent}" StringFormat="N3" />
        <controls:HM05_MetricTile Grid.Column="6" Grid.ColumnSpan="3" Margin="{StaticResource Inset.S}" Icon="{StaticResource Icon.Status.Warning}"
                                  Label="{res:Loc HS13_Bad_Label}" Value="{Binding BadCount}" StringFormat="N0" />
        <controls:HM07_ActionButton Grid.Column="9" Grid.ColumnSpan="3" Margin="{StaticResource Inset.S}" VerticalAlignment="Center" Icon="{StaticResource Icon.Action.Reset}"
                                    Label="{res:Loc HS13_ClearCounters_Label}" Command="{Binding ClearCountersCommand}"
                                    RequiresPermission="True" IsAuthorized="{Binding IsAuthorized}" />
      </Grid>
    </controls:HM15_GroupPanel>
  </Grid>
</UserControl>
