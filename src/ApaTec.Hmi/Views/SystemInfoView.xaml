<UserControl x:Class="ApaTec.Hmi.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ApaTec.Hmi.ViewModels"
             xmlns:controls="clr-namespace:ApaTec.Hmi.Controls"
             xmlns:res="clr-namespace:ApaTec.Hmi.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SystemInfoViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <DataTemplate x:Key="DriveRowTemplate" DataType="{x:Type vm:DriveRowViewModel}">
            <controls:HM34_DriveStatusRow DriveName="{Binding Name}" DiagCode="{Binding DiagCode}"
                                          CurrentActual="{Binding CurrentActual}" CurrentMax="{Binding CurrentMax}"
                                          CurrentLimit="{Binding CurrentLimit, Mode=OneWay}" Message="{Binding Message}"
                                          IsLimitAuthorized="{Binding IsLimitAuthorized}"
                                          ResetMaxCommand="{Binding ResetMaxCommand}" LimitCommand="{Binding LimitCommand}" />
        </DataTemplate>
    </UserControl.Resources>
    <!-- HS-39: zwei Gruppenbereiche 4 : 8 (Gutter Space.M): IPC links, Servomotoren rechts mit zwei Blaettertasten. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="1" Width="{StaticResource Space.M}" />

        <controls:HM15_GroupPanel Grid.Column="0" Header="{res:Loc HS39_Group_Ipc}">
            <StackPanel>
                <controls:HM10_ProgressBar Margin="{StaticResource Inset.S}" Label="{res:Loc HS39_Cpu_Label}"
                                           Value="{Binding CpuCurrent}" WarningThreshold="{Binding CpuWarningThreshold}" />
                <Grid Margin="{StaticResource Inset.S}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:HM11_ValueDisplay Grid.Column="0" Margin="{StaticResource Inset.XS}" FieldLabelPlacement="Top" Label="{res:Loc HS39_CpuCurrent_Label}"
                                                ValueKind="Number" Decimals="0" Unit="{res:Loc HS39_Unit_Percent}" NumberValue="{Binding CpuCurrent}" />
                    <controls:HM11_ValueDisplay Grid.Column="1" Margin="{StaticResource Inset.XS}" FieldLabelPlacement="Top" Label="{res:Loc HS39_CpuMax_Label}"
                                                ValueKind="Number" Decimals="0" Unit="{res:Loc HS39_Unit_Percent}" NumberValue="{Binding CpuMax}"
                                                ResetCommand="{Binding ResetCpuMaxCommand}" />
                </Grid>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" Text="{res:Loc HS39_SystemStart_Label}" />
                <controls:HM11_ValueDisplay Margin="{StaticResource Inset.S}" ValueKind="DateTime" TimeValue="{Binding SystemStart}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" Text="{res:Loc HS39_Runtime_Label}" />
                <controls:HM11_ValueDisplay Margin="{StaticResource Inset.S}" ValueKind="Duration" DurationLayout="Parts" TimeValue="{Binding TotalRuntime}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" Text="{res:Loc HS39_Status_Label}" />
                <controls:HM11_ValueDisplay Margin="{StaticResource Inset.S}" ValueKind="Text" TextValue="{Binding StatusText}" />
                <controls:HM11_ValueDisplay Margin="{StaticResource Inset.S}" ValueKind="Text" TextValue="{Binding DiagText}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" Text="{res:Loc HS39_Build_Label}" />
                <controls:HM11_ValueDisplay Margin="{StaticResource Inset.S}" ValueKind="DateTime" TimeValue="{Binding BuildTime}" />
            </StackPanel>
        </controls:HM15_GroupPanel>

        <controls:HM15_GroupPanel Grid.Column="2" Header="{res:Loc HS39_Group_Servo}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl Grid.Column="0" ItemsSource="{Binding VisibleDrives}" ItemTemplate="{StaticResource DriveRowTemplate}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" Rows="{Binding DrivePageSize}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <controls:HM19_PagerButtons Grid.Column="1" VerticalAlignment="Center" Orientation="Vertical" PositionMode="Range"
                                            Count="{Binding DriveCount}" RangeStart="{Binding RangeStart}" RangeEnd="{Binding RangeEnd}"
                                            PreviousCommand="{Binding ShowPreviousCommand}" NextCommand="{Binding ShowNextCommand}" />
            </Grid>
        </controls:HM15_GroupPanel>
    </Grid>
</UserControl>
