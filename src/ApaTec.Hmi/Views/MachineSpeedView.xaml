<UserControl x:Class="ApaTec.Hmi.Views.MachineSpeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:ApaTec.Hmi.Controls"
             xmlns:vm="clr-namespace:ApaTec.Hmi.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MachineSpeedViewModel, IsDesignTimeCreatable=True}">
    <!-- HS-03 Maschinengeschwindigkeit (Pop-up) im Rahmen HM-14, schmal (WidthRatio 0,4; S03-4): fuenf Eingabefelder HM-12; Antippen oeffnet das Eingabe-Pop-up HM-13 (ViewModel). -->
    <c:HM14_PopupFrame Title="{Binding Title}"
                       WidthRatio="0.4"
                       ShowCloseButton="True"
                       CloseCommand="{Binding CancelCommand}">
        <ItemsControl Focusable="False" ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MachineSpeedField}">
                    <c:HM12_ValueInput Margin="{StaticResource Inset.S}"
                                       Label="{Binding Label}"
                                       NumberValue="{Binding Value}"
                                       Unit="{Binding Unit}"
                                       Decimals="0"
                                       RequiresPermission="{Binding RequiresPermission}"
                                       IsAuthorized="{Binding IsAuthorized}"
                                       RequiredRole="{Binding RequiredRole}"
                                       IsPendingWrite="{Binding IsPendingWrite}"
                                       ErrorText="{Binding ErrorText}"
                                       Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </c:HM14_PopupFrame>
</UserControl>
