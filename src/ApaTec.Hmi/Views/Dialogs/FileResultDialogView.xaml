<UserControl x:Class="ApaTec.Hmi.Views.Dialogs.FileResultDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ApaTec.Hmi.ViewModels"
             xmlns:controls="clr-namespace:ApaTec.Hmi.Controls"
             xmlns:res="clr-namespace:ApaTec.Hmi.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FileResultDialogViewModel, IsDesignTimeCreatable=True}">
    <!-- Datei-/Ergebnis-Pop-up (HM-14 Art FileResult): Auswahl (Dateiname) mit Uebernehmen/Abbrechen oder Ergebnis (Erfolg/Fehler) mit Schliessen. -->
    <controls:HM14_PopupFrame Title="{Binding Title}" Kind="FileResult" WidthRatio="0.5" ShowCloseButton="False"
                              Message="{Binding Message}" ResultKind="{Binding ResultKind}" IsBusy="{Binding IsBusy}"
                              ConfirmCommand="{Binding AcceptCommand}" CancelCommand="{Binding CancelCommand}" CloseCommand="{Binding CancelCommand}">
        <StackPanel Margin="{StaticResource Inset.S}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelectMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource Text.Caption}" Text="{res:Loc Dialog_File_Name_Label}" />
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                    BorderThickness="{StaticResource Border.Thick}"
                    CornerRadius="{StaticResource Radius.Control}"
                    MinHeight="{StaticResource Size.Touch.Default}"
                    Margin="{StaticResource Inset.XS}">
                <TextBox MaxLength="80"
                         VerticalContentAlignment="Center"
                         Padding="{StaticResource Inset.S}"
                         FontSize="{StaticResource Font.Size.Value}"
                         Foreground="{DynamicResource Brush.Text.Primary}"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         Text="{Binding FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{res:Loc Dialog_File_Name_Label}" />
            </Border>
        </StackPanel>
    </controls:HM14_PopupFrame>
</UserControl>
