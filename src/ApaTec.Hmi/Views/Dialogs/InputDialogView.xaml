<UserControl x:Class="ApaTec.Hmi.Views.Dialogs.InputDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ApaTec.Hmi.ViewModels"
             xmlns:controls="clr-namespace:ApaTec.Hmi.Controls"
             xmlns:res="clr-namespace:ApaTec.Hmi.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InputDialogViewModel, IsDesignTimeCreatable=True}">
    <!-- Eingabe-Pop-up (HM-13) im Pop-up-Rahmen (HM-14): Zahl, Zeit, Text; Uebernehmen nur bei gueltigem Wert; Antippen ausserhalb schliesst nicht. -->
    <controls:HM14_PopupFrame Title="{res:Loc Dialog_Input_Title}" Kind="Content" ShowCloseButton="False" CloseCommand="{Binding CancelCommand}">
        <controls:HM13_NumericKeypadDialog Title="{Binding FieldTitle}"
                                           InputKind="{Binding Kind}"
                                           CurrentValue="{Binding CurrentValue}"
                                           InputText="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Unit="{Binding Unit}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                           Decimals="{Binding Decimals}" HelpText="{Binding HelpText}"
                                           IsValid="{Binding IsValid}" ErrorText="{Binding ErrorText}"
                                           ApplyCommand="{Binding AcceptCommand}" CancelCommand="{Binding CancelCommand}"
                                           DigitCommand="{Binding DigitCommand}" BackspaceCommand="{Binding BackspaceCommand}"
                                           ClearCommand="{Binding ClearCommand}" SignCommand="{Binding SignCommand}"
                                           DecimalSeparatorCommand="{Binding DecimalSeparatorCommand}" />
    </controls:HM14_PopupFrame>
</UserControl>
