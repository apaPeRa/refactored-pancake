<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:ApaTec.Hmi.Controls">
    <!-- Gemeinsame Stile der Heissleimseiten HS-07 bis HS-10. DataContext des Elements ist das jeweilige Feld-/Schalter-ViewModel. -->

    <!-- Eingabefeld HM-12 an HotGlueFieldViewModel -->
    <Style x:Key="HotGlue.Field" TargetType="c:HM12_ValueInput" BasedOn="{StaticResource {x:Type c:HM12_ValueInput}}">
        <Setter Property="NumberValue" Value="{Binding Value}" />
        <Setter Property="Decimals" Value="{Binding Decimals}" />
        <Setter Property="RequiresPermission" Value="True" />
        <Setter Property="IsAuthorized" Value="{Binding IsAuthorized}" />
        <Setter Property="IsEditing" Value="{Binding IsEditing}" />
        <Setter Property="IsPendingWrite" Value="{Binding IsPendingWrite}" />
        <Setter Property="ErrorText" Value="{Binding ErrorText}" />
        <Setter Property="Command" Value="{Binding EditCommand}" />
        <Setter Property="Margin" Value="{StaticResource Inset.S}" />
    </Style>

    <!-- Zustandstaste HM-08 an HotGlueSwitchViewModel -->
    <Style x:Key="HotGlue.Switch" TargetType="c:HM08_ToggleSwitch" BasedOn="{StaticResource {x:Type c:HM08_ToggleSwitch}}">
        <Setter Property="ToggleStyle" Value="Button" />
        <Setter Property="IsChecked" Value="{Binding IsOn, Mode=TwoWay}" />
        <Setter Property="IsPending" Value="{Binding IsPending}" />
        <Setter Property="ErrorText" Value="{Binding ErrorText}" />
        <Setter Property="Margin" Value="{StaticResource Inset.S}" />
    </Style>

    <!-- Beschreibung unter einem Feld (Handbuchtext) -->
    <Style x:Key="HotGlue.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Margin" Value="{StaticResource Inset.S}" />
    </Style>

    <!-- Abstandshalter zwischen Spalten (Gutter Space.M) -->
    <Style x:Key="HotGlue.Gutter" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Space.M}" />
    </Style>
</ResourceDictionary>
