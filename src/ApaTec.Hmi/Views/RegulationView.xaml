<UserControl x:Class="ApaTec.Hmi.Views.RegulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:ApaTec.Hmi.Controls"
             xmlns:vm="clr-namespace:ApaTec.Hmi.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RegulationViewModel, IsDesignTimeCreatable=True}">
    <!-- HS-23 Regulierung: zwei Panels 6 : 6 (Hauptdosierer | Nachdosierer), je ein HM-35, ohne Bildlauf. -->
    <UserControl.Resources>
        <!-- Lücke HM-35: keine Feldbefehle; der Stil gilt nur in dieser Seite, Parameter ist die Feldbeschriftung. -->
        <Style TargetType="{x:Type c:HM12_ValueInput}" BasedOn="{StaticResource {x:Type c:HM12_ValueInput}}">
            <Setter Property="Command" Value="{Binding EditFieldCommand}" />
            <Setter Property="CommandParameter" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <c:HM35_RegulationBlock Grid.Column="0" Margin="{StaticResource Inset.S}" VerticalAlignment="Top" DataContext="{Binding Main}"
                                Title="{Binding Title}" SampleCount="{Binding SampleCount, Mode=TwoWay}" Step="{Binding Step, Mode=TwoWay}"
                                Tolerance="{Binding Tolerance, Mode=TwoWay}" MaxCorrection="{Binding MaxCorrection, Mode=TwoWay}"
                                CurrentCorrection="{Binding CurrentCorrection, Mode=TwoWay}" Mean="{Binding Mean}" MeanCount="{Binding MeanCount}"
                                IsRegulationOn="{Binding IsRegulationOn, Mode=TwoWay}" IsAtLimit="{Binding IsAtLimit, Mode=OneWay}"
                                IsAuthorized="{Binding IsAuthorized}" ToggleCommand="{Binding ToggleCommand}"
                                DecreaseCommand="{Binding DecreaseCommand}" IncreaseCommand="{Binding IncreaseCommand}" />

        <c:HM35_RegulationBlock Grid.Column="1" Margin="{StaticResource Inset.S}" VerticalAlignment="Top" DataContext="{Binding Post}"
                                Title="{Binding Title}" SampleCount="{Binding SampleCount, Mode=TwoWay}" Step="{Binding Step, Mode=TwoWay}"
                                Tolerance="{Binding Tolerance, Mode=TwoWay}" MaxCorrection="{Binding MaxCorrection, Mode=TwoWay}"
                                CurrentCorrection="{Binding CurrentCorrection, Mode=TwoWay}" Mean="{Binding Mean}" MeanCount="{Binding MeanCount}"
                                IsRegulationOn="{Binding IsRegulationOn, Mode=TwoWay}" IsAtLimit="{Binding IsAtLimit, Mode=OneWay}"
                                IsAuthorized="{Binding IsAuthorized}" ToggleCommand="{Binding ToggleCommand}"
                                DecreaseCommand="{Binding DecreaseCommand}" IncreaseCommand="{Binding IncreaseCommand}" />
    </Grid>
</UserControl>
