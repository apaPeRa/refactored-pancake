<UserControl x:Class="ApaTec.Hmi.Views.FeederPaperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:ApaTec.Hmi.Controls"
             xmlns:vm="clr-namespace:ApaTec.Hmi.ViewModels"
             xmlns:res="clr-namespace:ApaTec.Hmi.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FeederPaperViewModel, IsDesignTimeCreatable=True}">
  <UserControl.Resources>
    <!-- Eingabefeld HM-12 an ein FeederValueField (DataContext des Felds) -->
    <Style x:Key="Feeder.Field" TargetType="{x:Type c:HM12_ValueInput}" BasedOn="{StaticResource {x:Type c:HM12_ValueInput}}">
      <Setter Property="Margin" Value="{StaticResource Inset.S}" />
      <Setter Property="Label" Value="{Binding Label}" />
      <Setter Property="NumberValue" Value="{Binding Value}" />
      <Setter Property="Unit" Value="{Binding Unit}" />
      <Setter Property="Minimum" Value="{Binding Minimum}" />
      <Setter Property="Maximum" Value="{Binding Maximum}" />
      <Setter Property="ErrorText" Value="{Binding ErrorText}" />
      <Setter Property="IsAuthorized" Value="{Binding IsAuthorized}" />
      <Setter Property="IsEditing" Value="{Binding IsEditing}" />
      <Setter Property="RequiredRole" Value="{Binding RequiredRoleText}" />
      <Setter Property="Command" Value="{Binding EditCommand}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
      <Setter Property="AutomationProperties.HelpText" Value="{Binding HelpText}" />
    </Style>
  </UserControl.Resources>
  <!-- HS-05 Zuführung Papier: Zeile 1 Packstoffrolle (12 Spalten), Zeile 2 Klebestelle (6) und Kupplung (6). Funktionsleiste leer. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <c:HM15_GroupPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource Inset.S}" Header="{res:Loc HS05_Group_Roll_Header}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <c:HM12_ValueInput Grid.Row="0" Grid.Column="0" Style="{StaticResource Feeder.Field}" DataContext="{Binding DiameterRollEnd}" />
        <c:HM12_ValueInput Grid.Row="0" Grid.Column="1" Style="{StaticResource Feeder.Field}" DataContext="{Binding BrakeStandstill}" />
        <c:HM12_ValueInput Grid.Row="1" Grid.Column="0" Style="{StaticResource Feeder.Field}" DataContext="{Binding DiameterMax}" />
        <c:HM12_ValueInput Grid.Row="1" Grid.Column="1" Style="{StaticResource Feeder.Field}" DataContext="{Binding BrakeAtMax}" />
        <c:HM12_ValueInput Grid.Row="2" Grid.Column="0" Style="{StaticResource Feeder.Field}" DataContext="{Binding DiameterMin}" />
        <c:HM12_ValueInput Grid.Row="2" Grid.Column="1" Style="{StaticResource Feeder.Field}" DataContext="{Binding BrakeAtMin}" />
        <c:HM11_ValueDisplay Grid.Row="3" Grid.Column="0" Margin="{StaticResource Inset.S}"
                             Label="{res:Loc HS05_RollDiameter_Label}" Unit="{res:Loc Feeder_Unit_Percent}"
                             NumberValue="{Binding RollDiameter}" IsLimitViolated="{Binding IsRollEndReached}"
                             AutomationProperties.HelpText="{res:Loc HS05_RollDiameter_Help}" />
        <c:HM11_ValueDisplay Grid.Row="3" Grid.Column="1" Margin="{StaticResource Inset.S}"
                             Label="{res:Loc HS05_BrakePressure_Label}" Unit="{res:Loc Feeder_Unit_Percent}"
                             NumberValue="{Binding BrakePressure}"
                             AutomationProperties.HelpText="{res:Loc HS05_BrakePressure_Help}" />
      </Grid>
    </c:HM15_GroupPanel>

    <c:HM15_GroupPanel Grid.Row="1" Grid.Column="0" Margin="{StaticResource Inset.S}" Header="{res:Loc HS05_Group_Splice_Header}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <c:HM12_ValueInput Grid.Row="0" Style="{StaticResource Feeder.Field}" DataContext="{Binding SpliceEjectCount}" />
        <c:HM09_StatusLed Grid.Row="1" Margin="{StaticResource Inset.S}" Label="{res:Loc HS05_SpliceDetected_Label}"
                          State="{Binding SpliceDetectedState}" StateText="{Binding SpliceDetectedText}"
                          AutomationProperties.HelpText="{res:Loc HS05_SpliceDetected_Help}" />
        <c:HM09_StatusLed Grid.Row="2" Margin="{StaticResource Inset.S}" Label="{res:Loc HS05_SpliceSensor_Label}"
                          State="{Binding SpliceSensorState}" StateText="{Binding SpliceSensorText}"
                          AutomationProperties.HelpText="{res:Loc HS05_SpliceSensor_Help}" />
      </Grid>
    </c:HM15_GroupPanel>

    <c:HM15_GroupPanel Grid.Row="1" Grid.Column="1" Margin="{StaticResource Inset.S}" Header="{res:Loc HS05_Group_Coupling_Header}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <c:HM12_ValueInput Grid.Row="0" Style="{StaticResource Feeder.Field}" DataContext="{Binding CouplingShift}" />
        <c:HM12_ValueInput Grid.Row="1" Style="{StaticResource Feeder.Field}" DataContext="{Binding CouplingStopPosition}" />
        <c:HM27_NoticeBox Grid.Row="2" Margin="{StaticResource Inset.S}" Kind="Warning" Text="{res:Loc HS05_Coupling_Notice}" />
      </Grid>
    </c:HM15_GroupPanel>
  </Grid>
</UserControl>
