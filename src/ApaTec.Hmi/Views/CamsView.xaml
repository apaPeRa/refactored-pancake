<UserControl x:Class="ApaTec.Hmi.Views.CamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:ApaTec.Hmi.Controls"
             xmlns:vm="clr-namespace:ApaTec.Hmi.ViewModels"
             xmlns:res="clr-namespace:ApaTec.Hmi.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CamsViewModel, IsDesignTimeCreatable=True}">
    <!-- HS-25 Nocken: 12 Spalten, sechs Zeilen (Beschriftung 2 | Feldbereich 6 | rechts 4); "Werte schreiben" ueber Zeile 4 und 5. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" MinHeight="{StaticResource Size.Touch.Default}" />
            <RowDefinition Height="1*" MinHeight="{StaticResource Size.Touch.Default}" />
            <RowDefinition Height="1*" MinHeight="{StaticResource Size.Touch.Default}" />
            <RowDefinition Height="1*" MinHeight="{StaticResource Size.Touch.Default}" />
            <RowDefinition Height="1*" MinHeight="{StaticResource Size.Touch.Default}" />
            <RowDefinition Height="1*" MinHeight="{StaticResource Size.Touch.Default}" />
        </Grid.RowDefinitions>

        <!-- Zeile 1: Nummer (ohne Schluessel), Direkteingabe, Positionsanzeige "n von m" -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="{StaticResource Inset.S}"
                   Text="{res:Loc HS25_Number_Label}" />
        <c:HM18_SelectorField Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="6" VerticalAlignment="Center" Margin="{StaticResource Inset.XS}" Label="{x:Null}"
                              DisplayText="{Binding NumberText}" AllowDirectEntry="True" DirectEntryCommand="{Binding EditNumberCommand}"
                              PreviousCommand="{Binding PreviousCamCommand}" NextCommand="{Binding NextCamCommand}" />
        <TextBlock Grid.Row="0" Grid.Column="8" Grid.ColumnSpan="4" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="{StaticResource Inset.S}"
                   Text="{Binding PositionText}" />

        <!-- Zeilen 2 und 3: Anfang / Ende (HM-24). Luecke HM-24: keine Feldbefehle; der Stil gilt nur in der Zeile und unterscheidet Winkel und Zeit ueber die Einheit. -->
        <c:HM24_CamParameterRow Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8" VerticalAlignment="Center"
                                Label="{res:Loc HS25_Start_Label}" Angle="{Binding StartAngle, Mode=TwoWay}" Time="{Binding StartTime, Mode=TwoWay}"
                                Result="{Binding StartResult}" IsPendingWrite="{Binding IsStartPending}">
            <c:HM24_CamParameterRow.Resources>
                <Style TargetType="{x:Type c:HM12_ValueInput}" BasedOn="{StaticResource {x:Type c:HM12_ValueInput}}">
                    <Setter Property="Command" Value="{Binding EditStartAngleCommand}" />
                    <Setter Property="IsAuthorized" Value="{Binding IsAuthorized}" />
                    <Style.Triggers>
                        <Trigger Property="Unit" Value="ms">
                            <Setter Property="Command" Value="{Binding EditStartTimeCommand}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </c:HM24_CamParameterRow.Resources>
        </c:HM24_CamParameterRow>
        <c:HM11_ValueDisplay Grid.Row="1" Grid.Column="8" Grid.ColumnSpan="4" VerticalAlignment="Center" Margin="{StaticResource Inset.XS}"
                             Label="{res:Loc HS25_Position_Label}" NumberValue="{Binding EncoderPosition}" Unit="{res:Loc Unit_Degree}" Decimals="0" />

        <c:HM24_CamParameterRow Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="8" VerticalAlignment="Center"
                                Label="{res:Loc HS25_End_Label}" Angle="{Binding EndAngle, Mode=TwoWay}" Time="{Binding EndTime, Mode=TwoWay}"
                                Result="{Binding EndResult}" IsPendingWrite="{Binding IsEndPending}">
            <c:HM24_CamParameterRow.Resources>
                <Style TargetType="{x:Type c:HM12_ValueInput}" BasedOn="{StaticResource {x:Type c:HM12_ValueInput}}">
                    <Setter Property="Command" Value="{Binding EditEndAngleCommand}" />
                    <Setter Property="IsAuthorized" Value="{Binding IsAuthorized}" />
                    <Style.Triggers>
                        <Trigger Property="Unit" Value="ms">
                            <Setter Property="Command" Value="{Binding EditEndTimeCommand}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </c:HM24_CamParameterRow.Resources>
        </c:HM24_CamParameterRow>
        <c:HM09_StatusLed Grid.Row="2" Grid.Column="8" Grid.ColumnSpan="4" VerticalAlignment="Center" Margin="{StaticResource Inset.XS}"
                          Label="{res:Loc HS25_Status_Label}" State="{Binding StatusLed}" StateText="{Binding StatusText}" />

        <!-- Zeile 4: Typ mit Hinweistext -->
        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="{StaticResource Inset.S}"
                   Text="{res:Loc HS25_Type_Label}" />
        <c:HM12_ValueInput Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="{StaticResource Inset.XS}"
                           InputKind="Number" Decimals="0" NumberValue="{Binding CamType}" IsPendingWrite="{Binding IsTypePending}"
                           RequiresPermission="True" IsAuthorized="{Binding IsAuthorized}" Command="{Binding EditTypeCommand}"
                           AutomationProperties.Name="{res:Loc HS25_Type_Label}" />
        <c:HM11_ValueDisplay Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="4" VerticalAlignment="Center" Margin="{StaticResource Inset.XS}"
                             ValueKind="Text" Presentation="Row" TextValue="{res:Loc HS25_TypeRange_Text}" />

        <!-- Zeilen 4 und 5 rechts: Werte schreiben -->
        <c:HM07_ActionButton Grid.Row="3" Grid.RowSpan="2" Grid.Column="8" Grid.ColumnSpan="4" VerticalAlignment="Center" Margin="{StaticResource Inset.XS}"
                             MinHeight="{StaticResource Size.Touch.Large}" Label="{res:Loc HS25_Write_Label}" Icon="{StaticResource Icon.Confirm}"
                             RequiresPermission="True" IsAuthorized="{Binding IsAuthorized}" Command="{Binding WriteValuesCommand}" />

        <!-- Zeile 5: Geber (Auswahl wirkt erst nach "Werte schreiben") -->
        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="{StaticResource Inset.S}"
                   Text="{res:Loc HS25_Encoder_Label}" />
        <c:HM18_SelectorField Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="6" VerticalAlignment="Center" Margin="{StaticResource Inset.XS}" Label="{x:Null}"
                              DisplayText="{Binding EncoderName}" RequiresPermission="True" IsAuthorized="{Binding IsAuthorized}"
                              RequiresApply="True" IsPending="{Binding IsEncoderPending}"
                              PreviousCommand="{Binding PreviousEncoderCommand}" NextCommand="{Binding NextEncoderCommand}" />

        <!-- Zeile 6: Bezeichnung (Text) -->
        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="{StaticResource Inset.S}"
                   Text="{res:Loc HS25_Designation_Label}" />
        <c:HM12_ValueInput Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="10" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="{StaticResource Inset.XS}"
                           InputKind="Text" TextValue="{Binding Designation}" IsPendingWrite="{Binding IsDesignationPending}"
                           RequiresPermission="True" IsAuthorized="{Binding IsAuthorized}" Command="{Binding EditDesignationCommand}"
                           AutomationProperties.Name="{res:Loc HS25_Designation_Label}" />
    </Grid>
</UserControl>
