<UserControl x:Class="ApaTec.Hmi.Views.SingleWeightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ApaTec.Hmi.ViewModels"
             xmlns:controls="clr-namespace:ApaTec.Hmi.Controls"
             xmlns:res="clr-namespace:ApaTec.Hmi.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SingleWeightsViewModel, IsDesignTimeCreatable=True}">
    <!-- HS-14 Einzelgewichte: Kennzahlenzeile (1*) mit drei Kacheln zu je 4 Spalten, darunter das Wertegitter 10 x 5 (9*). Umschalter und Start liegen in der Funktionsleiste. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="1*" />
      <RowDefinition Height="9*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:HM05_MetricTile Grid.Column="0" Margin="{StaticResource Inset.S}" Icon="{StaticResource Icon.Stat.StdDev}"
                                Label="{res:Loc HS14_StdDev_Label}" Value="{Binding StdDev}" Unit="{res:Loc HS14_Unit_Gram}" StringFormat="N1" />
      <controls:HM05_MetricTile Grid.Column="1" Margin="{StaticResource Inset.S}" Icon="{StaticResource Icon.Stat.Mean}"
                                Label="{res:Loc HS14_Mean_Label}" Value="{Binding Mean}" Unit="{res:Loc HS14_Unit_Gram}" StringFormat="N1" />
      <controls:HM05_MetricTile Grid.Column="2" Margin="{StaticResource Inset.S}"
                                Label="{res:Loc HS14_Count_Label}" Value="{Binding Capacity}" StringFormat="N0" />
    </Grid>
    <controls:HM37_ValueGrid Grid.Row="1" Margin="{StaticResource Inset.S}"
                             AutomationProperties.Name="{res:Loc HS14_Grid_Name}"
                             Cells="{Binding Cells}" LastIndex="{Binding LastIndex}" Mode="{Binding Mode}" Capacity="{Binding Capacity}"
                             StartCommand="{Binding StartCommand}" ToggleModeCommand="{Binding ToggleModeCommand}" />
  </Grid>
</UserControl>
