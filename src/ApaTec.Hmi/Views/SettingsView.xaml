<UserControl x:Class="ApaTec.Hmi.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:ApaTec.Hmi.Controls"
             xmlns:vm="clr-namespace:ApaTec.Hmi.ViewModels"
             xmlns:res="clr-namespace:ApaTec.Hmi.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=True}">
  <!-- HS-04 Einstellungen: 12-Spalten-Raster 4 : 4 : 4, links Schnellzugriff (Beleuchtung), Mitte und rechts je ein Kachelraster 2 x 4 (A-36). -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="4*" />
      <ColumnDefinition Width="4*" />
      <ColumnDefinition Width="4*" />
    </Grid.ColumnDefinitions>

    <c:HM15_GroupPanel Grid.Column="0" Margin="{StaticResource Inset.S}" Header="{res:Loc HS04_Group_Quick_Header}">
      <Grid VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <c:HM16_TileNavigation Grid.Column="0" Columns="1" Rows="1" TileSize="Small" ShowNavigationIndicator="False"
                               Items="{Binding QuickTiles}" NavigateCommand="{Binding OpenTileCommand}" />
      </Grid>
    </c:HM15_GroupPanel>

    <c:HM15_GroupPanel Grid.Column="1" Margin="{StaticResource Inset.S}" AutomationProperties.Name="{res:Loc HS04_Group_Plant_Name}">
      <c:HM16_TileNavigation Columns="2" Rows="4" TileSize="Large" Items="{Binding PlantTiles}" NavigateCommand="{Binding OpenTileCommand}" />
    </c:HM15_GroupPanel>

    <c:HM15_GroupPanel Grid.Column="2" Margin="{StaticResource Inset.S}" AutomationProperties.Name="{res:Loc HS04_Group_System_Name}">
      <c:HM16_TileNavigation Columns="2" Rows="4" TileSize="Large" Items="{Binding SystemTiles}" NavigateCommand="{Binding OpenTileCommand}" />
    </c:HM15_GroupPanel>
  </Grid>
</UserControl>
