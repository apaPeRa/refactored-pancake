<?xml version="1.0" encoding="utf-8"?>
<!-- HM-07 Aktionstaste: Stil und ControlTemplate fuer HM07_ActionButton (Button). Flach, 64 px hoch, Zustaende Normal, Gedrueckt, Halten, Laeuft/Gehalten, Deaktiviert,
     Berechtigung vorhanden (Schluessel) und fehlt (Schloss); zweiter Kanal siehe HM-07. Farben nur DynamicResource Brush.*, Masse StaticResource aus Tokens.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Symbol (Raster 24 x 24, Strich 2 px aus Border.Medium, runde Enden) -->
  <Style x:Key="HM07.Icon" TargetType="Path">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="Height" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Size.Icon.Stroke}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style TargetType="{x:Type local:HM07_ActionButton}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}" />
    <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Regular}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Button.Normal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.Button.MinWidth}" />
    <Setter Property="Padding" Value="{StaticResource Inset.Button}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM07_ActionButton}">
          <Grid>
            <Border x:Name="Face"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Control}"
                    Padding="{TemplateBinding Padding}">
              <Grid>
                <StackPanel HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path x:Name="IconPath"
                          Style="{StaticResource HM07.Icon}"
                          Data="{TemplateBinding Icon}"
                          Stroke="{TemplateBinding Foreground}"
                          Margin="{StaticResource Inset.XS}" />
                    <TextBlock x:Name="LabelText"
                               Text="{TemplateBinding Label}"
                               Foreground="{TemplateBinding Foreground}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <!-- Zweiter Kanal Laeuft / Gehalten: Symbol Haken und Wort -->
                  <StackPanel x:Name="RunningRow" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Path Style="{StaticResource HM07.Icon}"
                          Data="{StaticResource Icon.State.On}"
                          Stroke="{TemplateBinding Foreground}"
                          Margin="{StaticResource Inset.XS}" />
                    <TextBlock Text="{res:Loc HM07_Running_Word}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{StaticResource Font.Size.Caption}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <!-- Zweiter Kanal Halten: Text -->
                  <TextBlock x:Name="HoldText"
                             Visibility="Collapsed"
                             Text="{res:Loc HM07_Holding_Text}"
                             Foreground="{TemplateBinding Foreground}"
                             FontSize="{StaticResource Font.Size.Caption}"
                             HorizontalAlignment="Center" />
                </StackPanel>
                <!-- Fortschrittsstreifen unten (Halten): Breite ueber ScaleX = HoldProgress -->
                <Border x:Name="HoldStrip"
                        Visibility="Collapsed"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Height="{StaticResource Space.XS}"
                        Background="{DynamicResource Brush.Progress.Fill}"
                        RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding HoldProgress, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Border.RenderTransform>
                </Border>
              </Grid>
            </Border>
            <!-- Zweiter Kanal Deaktiviert: gestrichelte Kontur -->
            <Rectangle x:Name="DisabledDash"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"
                       RadiusX="{StaticResource Radius.Control.Size}" RadiusY="{StaticResource Radius.Control.Size}"
                       Stroke="{DynamicResource Brush.Border.Control}"
                       StrokeThickness="{StaticResource Border.Thin.Size}"
                       StrokeDashArray="{StaticResource Border.Dash}" />
            <!-- Fokus: 3 px Rahmen -->
            <Border x:Name="FocusRing"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                    BorderThickness="{StaticResource Border.Thick}"
                    CornerRadius="{StaticResource Radius.Control}" />
            <!-- Berechtigung: Schluessel (vorhanden) oder Schloss (fehlt), 24 px rechts mittig; die Taste reserviert dafuer Innenabstand (Inset.Button.Permission, S-04) -->
            <Path x:Name="KeyIcon"
                  Visibility="Collapsed"
                  Style="{StaticResource HM07.Icon}"
                  Data="{StaticResource Icon.Key}"
                  Stroke="{DynamicResource Brush.Text.Primary}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="{StaticResource Inset.S}" />
            <Path x:Name="LockIcon"
                  Visibility="Collapsed"
                  Style="{StaticResource HM07.Icon}"
                  Data="{StaticResource Icon.Lock}"
                  Stroke="{DynamicResource Brush.Text.Primary}"
                  ToolTip="{res:Loc HM07_PermissionRequired_Hint}"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="{StaticResource Inset.S}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsRunning" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Active}" />
              <Setter TargetName="RunningRow" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnActive}" />
            </Trigger>
            <Trigger Property="IsHolding" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Pressed}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
              <Setter TargetName="HoldStrip" Property="Visibility" Value="Visible" />
              <Setter TargetName="HoldText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Pressed}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="RequiresPermission" Value="True" />
                <Condition Property="IsAuthorized" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="KeyIcon" Property="Visibility" Value="Visible" />
              <Setter TargetName="Face" Property="Padding" Value="{StaticResource Inset.Button.Permission}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="RequiresPermission" Value="True" />
                <Condition Property="IsAuthorized" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="LockIcon" Property="Visibility" Value="Visible" />
              <Setter TargetName="Face" Property="Padding" Value="{StaticResource Inset.Button.Permission}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Disabled}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="DisabledDash" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
