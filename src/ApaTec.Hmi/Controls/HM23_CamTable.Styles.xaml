<?xml version="1.0" encoding="utf-8"?>
<!-- HM23_CamTable.Styles.xaml: Template der Nockentabelle (HM-23); Zeile = DataTemplate HM23.CamRow (HM23_CamRow), Status HM-09 kompakt.
     Auswahl ueber ListBox.SelectedValue (Rahmen Border.Thick), Zeilenhoehe Size.Touch.Min, Abstand der Nummernfelder Size.Touch.Gap (4 + 4 + 4 + 4 Rand/Abstand). Keine Logik, keine Literale. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="HM23.IconPath" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{Binding Source={StaticResource Border.Medium}, Path=Left}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>


  <!-- Zeile: Nummer (Touch-Ziel) | Bezeichnung | Start | Ende | Status. Leere Nocke (0/0): Text sekundaer, Bezeichnung "-". -->
  <DataTemplate x:Key="HM23.CamRow" DataType="{x:Type local:CamRow}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="HM23Number" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" SharedSizeGroup="HM23Start" />
        <ColumnDefinition Width="Auto" SharedSizeGroup="HM23End" />
        <ColumnDefinition Width="Auto" SharedSizeGroup="HM23Status" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Margin="{StaticResource Inset.XS}" MinHeight="{StaticResource Size.Touch.Min}"
              Content="{Binding Number}" CommandParameter="{Binding Number}"
              Command="{Binding SelectCommand, RelativeSource={RelativeSource AncestorType={x:Type local:HM23_CamTable}}}"
              AutomationProperties.Name="{res:Loc HM23_Number_Name}" />
      <TextBlock x:Name="NameText" Grid.Column="1" Style="{StaticResource Text.Body}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
      <TextBlock x:Name="StartText" Grid.Column="2" Style="{StaticResource Text.Body}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center"
                 Text="{Binding StartAngle, StringFormat='{}{0:0}&#160;°'}" />
      <TextBlock x:Name="EndText" Grid.Column="3" Style="{StaticResource Text.Body}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center"
                 Text="{Binding EndAngle, StringFormat='{}{0:0}&#160;°'}" />
      <local:HM09_StatusLed x:Name="StatusLed" Grid.Column="4" Margin="{StaticResource Inset.XS}" IsCompact="True" ShowStateWord="True" State="Off" />
    </Grid>
    <DataTemplate.Triggers>
      <!-- aktiv: LED Ok mit Haken und Wort; Zeilenflaeche bleibt neutral -->
      <DataTrigger Binding="{Binding IsActive}" Value="True">
        <Setter TargetName="StatusLed" Property="State" Value="On" />
        <Setter TargetName="StatusLed" Property="StateText" Value="{res:Loc HM23_Active_Text}" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding StartAngle}" Value="0" />
          <Condition Binding="{Binding EndAngle}" Value="0" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="NameText" Property="Text" Value="{res:Loc HM23_Empty_Name}" />
        <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter TargetName="StartText" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter TargetName="EndText" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      </MultiDataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Zeilencontainer: Auswahl = Rahmen Border.Thick in Brush.Border.Focus (Form als zweiter Kanal) -->
  <Style x:Key="HM23.RowContainer" TargetType="ListBoxItem">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Margin" Value="{StaticResource Inset.XS}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{StaticResource Border.Thick}" CornerRadius="{StaticResource Radius.Control}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HM23.List" TargetType="ListBox">
    <Setter Property="Background" Value="{x:Null}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
    <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:HM23_CamTable}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM23_CamTable}">
          <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="{StaticResource Inset.XS}" Padding="{StaticResource Inset.XS}" BorderBrush="{DynamicResource Brush.Divider}"
                    BorderThickness="{StaticResource Border.Thin}" Background="{DynamicResource Brush.Surface.Sunken}" CornerRadius="{StaticResource Radius.Control}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="HM23Number" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="HM23Start" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="HM23End" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="HM23Status" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" Text="{res:Loc HM23_Number_Header}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" Text="{res:Loc HM23_Name_Header}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" Text="{res:Loc HM23_Start_Header}" />
                <TextBlock Grid.Column="3" Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" Text="{res:Loc HM23_End_Header}" />
                <TextBlock Grid.Column="4" Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" Text="{res:Loc HM23_Status_Header}" />
              </Grid>
            </Border>
            <ListBox Grid.Row="1" Style="{StaticResource HM23.List}" ItemContainerStyle="{StaticResource HM23.RowContainer}"
                     ItemTemplate="{StaticResource HM23.CamRow}" ItemsSource="{Binding Rows, RelativeSource={RelativeSource TemplatedParent}}"
                     SelectedValuePath="Number" SelectedValue="{Binding SelectedNumber, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
