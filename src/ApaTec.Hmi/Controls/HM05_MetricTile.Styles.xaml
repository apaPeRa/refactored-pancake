<?xml version="1.0" encoding="utf-8"?>
<!-- HM-05 Kennzahl-Kachel (HM05_MetricTile): Symbol (Size.Icon.M), Wert (Font.Size.Metric, tabellarische Ziffern), Einheit (Font.Size.Caption), optionaler Index unten rechts.
     Zweiter Kanal: Symbol + Einheit als Text; antippbar = Chevron rechts (IsInteractive), gedrueckt = Border.Medium + Brush.Button.Pressed; ungueltiger Wert = Strich-Text.
     Reine Anzeige reagiert nicht auf Beruehrung (kein Fokus, kein Treffer). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls">

  <Style TargetType="{x:Type local:HM05_MetricTile}">
    <Setter Property="Command" Value="{Binding OpenCommand, RelativeSource={RelativeSource Self}}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM05_MetricTile}">
          <ControlTemplate.Resources>
            <local:HM05_ValueFormatConverter x:Key="ValueFormat" />
          </ControlTemplate.Resources>
          <Grid>
            <Border x:Name="Face"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Divider}"
                    BorderThickness="{StaticResource Border.Thin}"
                    CornerRadius="{StaticResource Radius.Card}"
                    Padding="{StaticResource Inset.S}">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox x:Name="IconBox" Grid.Column="0" VerticalAlignment="Center"
                         Width="{StaticResource Size.Icon.M}" Height="{StaticResource Size.Icon.M}">
                  <Grid>
                    <Path Data="M0,0 H24 V24 H0 Z" Fill="Transparent" />
                    <Path StrokeThickness="{Binding Source={StaticResource Border.Medium}, Path=Left}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{DynamicResource Brush.Text.Primary}"
                          Data="{TemplateBinding Icon}" />
                  </Grid>
                </Viewbox>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource Inset.S}">
                  <TextBlock x:Name="LabelText"
                             Style="{StaticResource Text.Caption}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             Text="{TemplateBinding Label}" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ValueText"
                               Style="{StaticResource Text.Metric}"
                               TextWrapping="NoWrap">
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource ValueFormat}">
                          <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="TimeValue" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="StringFormat" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <!-- geschuetztes Leerzeichen zwischen Wert und Einheit -->
                    <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" TextWrapping="NoWrap"><Run xml:space="preserve">&#160;</Run><Run Text="{Binding Unit, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /></TextBlock>
                  </StackPanel>
                </StackPanel>

                <Viewbox x:Name="Chevron" Grid.Column="2" VerticalAlignment="Center" Visibility="Collapsed"
                         Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                  <Grid>
                    <Path Data="M0,0 H24 V24 H0 Z" Fill="Transparent" />
                    <Path Data="{StaticResource Icon.Chevron}"
                          StrokeThickness="{Binding Source={StaticResource Border.Medium}, Path=Left}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{DynamicResource Brush.Text.Secondary}" />
                  </Grid>
                </Viewbox>
              </Grid>
            </Border>

            <!-- Index unten rechts -->
            <TextBlock x:Name="IndexText"
                       Style="{StaticResource Text.Caption}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="{StaticResource Inset.XS}"
                       TextWrapping="NoWrap"
                       Text="{Binding Index, RelativeSource={RelativeSource TemplatedParent}}" />

            <Border x:Name="FocusRing" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                    BorderThickness="{StaticResource Border.Thick}"
                    CornerRadius="{StaticResource Radius.Card}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Label" Value="">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Index" Value="{x:Null}">
              <Setter TargetName="IndexText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsInteractive" Value="True">
              <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Pressed}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="TileSize" Value="Frame">
        <Setter Property="MinWidth" Value="{StaticResource Size.Metric.MinWidth}" />
      </Trigger>
      <!-- Reine Anzeige: weder Fokus noch Treffer -->
      <Trigger Property="IsInteractive" Value="False">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
