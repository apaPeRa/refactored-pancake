<?xml version="1.0" encoding="utf-8"?>
<!-- HM-09 Status-LED: Stil und ControlTemplate fuer HM09_StatusLed (Control). Nur Anzeige. Zustand ueber Symbolform (leerer Kreis, Haken, Dreieck, Kreuz) in der Statusfarbe (.Fg, ohne Flaeche) und Wort. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="HM09.Icon" TargetType="Path">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="{StaticResource Size.Led}" />
    <Setter Property="Height" Value="{StaticResource Size.Led}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Size.Icon.Stroke}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Zustandswort: StateText ueberschreibt, sonst Standardwort des Zustands (Ressourcen) -->
  <Style x:Key="HM09.Word" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Text" Value="{Binding StateText, RelativeSource={RelativeSource TemplatedParent}}" />
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding StateText, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
          <Condition Binding="{Binding State, RelativeSource={RelativeSource TemplatedParent}}" Value="Off" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Text" Value="{res:Loc State_Off_Word}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding StateText, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
          <Condition Binding="{Binding State, RelativeSource={RelativeSource TemplatedParent}}" Value="On" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Text" Value="{res:Loc Status_Ok_Word}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding StateText, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
          <Condition Binding="{Binding State, RelativeSource={RelativeSource TemplatedParent}}" Value="Warning" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Text" Value="{res:Loc Status_Warning_Word}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding StateText, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
          <Condition Binding="{Binding State, RelativeSource={RelativeSource TemplatedParent}}" Value="Error" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Text" Value="{res:Loc Status_Error_Word}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding StateText, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
          <Condition Binding="{Binding State, RelativeSource={RelativeSource TemplatedParent}}" Value="Unknown" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Text" Value="{res:Loc HM09_Unknown_Word}" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type local:HM09_StatusLed}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}" />
    <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Regular}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Min}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM09_StatusLed}">
          <Grid x:Name="Root"
                ToolTip="{Binding Text, ElementName=WordText}"
                AutomationProperties.Name="{Binding Text, ElementName=WordText}"
                Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Fachsymbol (optional), z. B. Trichter -->
            <Path x:Name="SubjectIcon"
                  Grid.Column="0"
                  Style="{StaticResource HM09.Icon}"
                  Data="{TemplateBinding Icon}"
                  Stroke="{TemplateBinding Foreground}"
                  Margin="{StaticResource Inset.XS}" />
            <!-- LED: Statussymbol ohne Flaeche in der Statusfarbe -->
            <Path x:Name="LedIcon"
                  Grid.Column="1"
                  Style="{StaticResource HM09.Icon}"
                  Data="{StaticResource Icon.Status.Inactive}"
                  Stroke="{DynamicResource Brush.Status.Inactive.Fg}"
                  Margin="{StaticResource Inset.XS}" />
            <StackPanel x:Name="LabelPanel" Grid.Column="2" VerticalAlignment="Center" Margin="{StaticResource Inset.S}">
              <TextBlock x:Name="LabelText"
                         Text="{TemplateBinding Label}"
                         Foreground="{TemplateBinding Foreground}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="IdentifierText"
                         Text="{TemplateBinding Identifier}"
                         Foreground="{DynamicResource Brush.Text.Secondary}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{StaticResource Font.Size.Caption}" />
            </StackPanel>
            <TextBlock x:Name="WordText"
                       Grid.Column="3"
                       Style="{StaticResource HM09.Word}"
                       Foreground="{TemplateBinding Foreground}"
                       FontFamily="{TemplateBinding FontFamily}"
                       Margin="{StaticResource Inset.XS}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="SubjectIcon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Label" Value="">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Identifier" Value="">
              <Setter TargetName="IdentifierText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="State" Value="On">
              <Setter TargetName="LedIcon" Property="Data" Value="{StaticResource Icon.Status.Ok}" />
              <Setter TargetName="LedIcon" Property="Stroke" Value="{DynamicResource Brush.Status.Ok.Fg}" />
            </Trigger>
            <Trigger Property="State" Value="Warning">
              <Setter TargetName="LedIcon" Property="Data" Value="{StaticResource Icon.Status.Warning}" />
              <Setter TargetName="LedIcon" Property="Stroke" Value="{DynamicResource Brush.Status.Warning.Fg}" />
            </Trigger>
            <Trigger Property="State" Value="Error">
              <Setter TargetName="LedIcon" Property="Data" Value="{StaticResource Icon.Status.Error}" />
              <Setter TargetName="LedIcon" Property="Stroke" Value="{DynamicResource Brush.Status.Error.Fg}" />
            </Trigger>
            <Trigger Property="ShowStateWord" Value="False">
              <Setter TargetName="WordText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- Kompakt: ohne Beschriftung, kleinere LED; Wort nur ueber ShowStateWord, sonst als Tooltip -->
            <Trigger Property="IsCompact" Value="True">
              <Setter TargetName="LabelPanel" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="LedIcon" Property="Width" Value="{StaticResource Size.Icon.S}" />
              <Setter TargetName="LedIcon" Property="Height" Value="{StaticResource Size.Icon.S}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
