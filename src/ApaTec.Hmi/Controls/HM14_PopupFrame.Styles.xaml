<?xml version="1.0" encoding="utf-8"?>
<!-- HM-14 Pop-up-Rahmen: Titelzeile (Size.Popup.TitleHeight) mit Schliessen-Kreuz, freier Inhalt, Tasten unten. Kein Schatten, Tiefe ueber Scrim (Host) und Kontur.
     Varianten ueber Kind: Content, Confirmation (Warnsymbol, Ja/Abbrechen, Fokus auf Abbrechen), FileResult (Auswahl, Laeuft, Erfolg/Fehler jeweils mit Symbol und Text). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <local:HM14_WidthRatioConverter x:Key="HM14_WidthRatioConverter" />
  <local:HM14_IsNullConverter x:Key="HM14_IsNullConverter" />

  <!-- Symbol-Linie im 24er-Raster (Strichstaerke aus Border.Medium) -->
  <Style x:Key="HM14_IconPath" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Size.Icon.Stroke}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>

  <!-- Schliessen-Kreuz oben rechts: Size.Touch.Default x Size.Touch.Default -->
  <Style x:Key="HM14_CloseCrossStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="Height" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="Margin" Value="{StaticResource Inset.S}" />
    <Setter Property="Padding" Value="{StaticResource Inset.S}" />
  </Style>

  <Style TargetType="{x:Type local:HM14_PopupFrame}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM14_PopupFrame}">
          <Border x:Name="Root"
                  Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Border.Control}"
                  BorderThickness="{StaticResource Border.Medium}"
                  CornerRadius="{StaticResource Radius.Card}"
                  MinWidth="{StaticResource Size.Metric.MinWidth}">
            <!-- Esc schliesst das Pop-up wie das Kreuz (CloseCommand), solange der Fokus im Rahmen liegt -->
            <Border.InputBindings>
              <KeyBinding Key="Escape" Command="{Binding CloseCommand, RelativeSource={RelativeSource TemplatedParent}}" />
            </Border.InputBindings>
            <Border.MaxWidth>
              <MultiBinding Converter="{StaticResource HM14_WidthRatioConverter}">
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="WidthRatio" />
                <Binding Source="{StaticResource Size.Window.Width}" />
              </MultiBinding>
            </Border.MaxWidth>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Titelzeile -->
              <Grid Grid.Row="0" MinHeight="{StaticResource Size.Popup.TitleHeight}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Viewbox x:Name="WarningIcon" Grid.Column="0" Visibility="Collapsed"
                         Width="{StaticResource Size.Icon.M}" Height="{StaticResource Size.Icon.M}"
                         Margin="{StaticResource Inset.M}" VerticalAlignment="Center">
                  <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                    <Path Style="{StaticResource HM14_IconPath}" Stroke="{DynamicResource Brush.Status.Warning.Fg}" Data="{StaticResource Icon.Status.Warning}" />
                  </Grid>
                </Viewbox>
                <TextBlock x:Name="TitleText" Grid.Column="1"
                           Style="{StaticResource Text.Title}"
                           Text="{TemplateBinding Title}"
                           Margin="{StaticResource Inset.M}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <Button x:Name="BtnX" Grid.Column="2"
                        Style="{StaticResource HM14_CloseCrossStyle}"
                        Command="{TemplateBinding CloseCommand}"
                        AutomationProperties.Name="{res:Loc HM14_Close_Name}">
                  <Viewbox Width="{StaticResource Size.Icon.M}" Height="{StaticResource Size.Icon.M}">
                    <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                      <Path Style="{StaticResource HM14_IconPath}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="{StaticResource Icon.Close}" />
                    </Grid>
                  </Viewbox>
                </Button>
                <Rectangle Grid.ColumnSpan="3" VerticalAlignment="Bottom"
                           Height="{StaticResource Border.Thin.Size}"
                           Fill="{DynamicResource Brush.Divider}" />
              </Grid>

              <!-- Inhalt: bei knapper Hoehe scrollbar, damit Titel und Tasten sichtbar bleiben (B-04) -->
              <ScrollViewer Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
              <StackPanel Margin="{StaticResource Inset.M}">
                <ContentPresenter x:Name="Body"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                <Border x:Name="MessageBox"
                        BorderBrush="Transparent"
                        BorderThickness="{StaticResource Border.Medium}"
                        CornerRadius="{StaticResource Radius.Control}"
                        Padding="{StaticResource Inset.S}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox x:Name="ResultOkIcon" Visibility="Collapsed"
                             Width="{StaticResource Size.Icon.L}" Height="{StaticResource Size.Icon.L}"
                             Margin="{StaticResource Inset.S}" VerticalAlignment="Center">
                      <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                        <Path Style="{StaticResource HM14_IconPath}" Stroke="{DynamicResource Brush.Status.Ok.Fg}" Data="{StaticResource Icon.Status.Ok}" />
                      </Grid>
                    </Viewbox>
                    <Viewbox x:Name="ResultErrorIcon" Visibility="Collapsed"
                             Width="{StaticResource Size.Icon.L}" Height="{StaticResource Size.Icon.L}"
                             Margin="{StaticResource Inset.S}" VerticalAlignment="Center">
                      <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                        <Path Style="{StaticResource HM14_IconPath}" Stroke="{DynamicResource Brush.Status.Error.Fg}" Data="{StaticResource Icon.Status.Error}" />
                      </Grid>
                    </Viewbox>
                    <TextBlock x:Name="MessageText" Grid.Column="1"
                               Style="{StaticResource Text.Body}"
                               Text="{TemplateBinding Message}"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="{StaticResource Inset.S}">
                  <ProgressBar Height="{StaticResource Size.Progress.Height}"
                               Maximum="100"
                               Foreground="{DynamicResource Brush.Progress.Fill}"
                               Background="{DynamicResource Brush.Surface.Sunken}"
                               BorderBrush="{DynamicResource Brush.Border.Control}"
                               BorderThickness="{StaticResource Border.Thin}"
                               Value="{Binding Progress, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, TargetNullValue=0}"
                               IsIndeterminate="{Binding Progress, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={StaticResource HM14_IsNullConverter}}" />
                  <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                             Text="{Binding Progress, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat={}{0:0}&#160;%}" />
                </StackPanel>
              </StackPanel>
              </ScrollViewer>

              <!-- Tasten -->
              <Grid Grid.Row="2">
                <Rectangle VerticalAlignment="Top"
                           Height="{StaticResource Border.Thin.Size}"
                           Fill="{DynamicResource Brush.Divider}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Inset.S}">
                  <Button x:Name="BtnCancel" Visibility="Collapsed" Margin="{StaticResource Inset.S}"
                          Command="{TemplateBinding CancelCommand}">
                    <Grid>
                      <TextBlock x:Name="CancelDefault" Text="{res:Loc Popup_Cancel_Label}" Visibility="Collapsed" />
                      <TextBlock x:Name="CancelCustom" Text="{TemplateBinding CancelText}" />
                    </Grid>
                  </Button>
                  <Button x:Name="BtnConfirm" Visibility="Collapsed" Margin="{StaticResource Inset.S}"
                          Command="{TemplateBinding ConfirmCommand}">
                    <Grid>
                      <TextBlock x:Name="ConfirmYes" Text="{res:Loc HM14_Confirm_Label}" Visibility="Collapsed" />
                      <TextBlock x:Name="ConfirmAccept" Text="{res:Loc Popup_Accept_Label}" Visibility="Collapsed" />
                      <TextBlock x:Name="ConfirmCustom" Text="{TemplateBinding ConfirmText}" />
                    </Grid>
                  </Button>
                  <Button x:Name="BtnClose" Margin="{StaticResource Inset.S}"
                          Command="{TemplateBinding CloseCommand}"
                          Content="{res:Loc Popup_Close_Label}" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <!-- Standardtexte, wenn keine eigenen gesetzt sind -->
            <Trigger Property="CancelText" Value="{x:Null}">
              <Setter TargetName="CancelCustom" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="CancelDefault" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="ConfirmText" Value="{x:Null}">
              <Setter TargetName="ConfirmCustom" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="ConfirmYes" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Message" Value="{x:Null}">
              <Setter TargetName="MessageBox" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ShowCloseButton" Value="False">
              <Setter TargetName="BtnClose" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- Bestaetigung: Warnsymbol im Titel, Ja/Abbrechen, Fokus zunaechst auf Abbrechen -->
            <Trigger Property="Kind" Value="Confirmation">
              <Setter TargetName="WarningIcon" Property="Visibility" Value="Visible" />
              <Setter TargetName="BtnClose" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="BtnCancel" Property="Visibility" Value="Visible" />
              <Setter TargetName="BtnConfirm" Property="Visibility" Value="Visible" />
              <Setter TargetName="Root" Property="FocusManager.IsFocusScope" Value="True" />
              <Setter TargetName="Root" Property="FocusManager.FocusedElement" Value="{Binding ElementName=BtnCancel}" />
            </Trigger>
            <!-- Datei/Ergebnis: Auswahl mit Uebernehmen/Abbrechen -->
            <Trigger Property="Kind" Value="FileResult">
              <Setter TargetName="BtnClose" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="BtnCancel" Property="Visibility" Value="Visible" />
              <Setter TargetName="BtnConfirm" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="FileResult" />
                <Condition Property="ConfirmText" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="ConfirmYes" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="ConfirmAccept" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <!-- Datei/Ergebnis: Laeuft (Fortschritt, Tasten deaktiviert = gestrichelt) -->
            <Trigger Property="IsBusy" Value="True">
              <Setter TargetName="ProgressPanel" Property="Visibility" Value="Visible" />
              <Setter TargetName="BtnCancel" Property="IsEnabled" Value="False" />
              <Setter TargetName="BtnConfirm" Property="IsEnabled" Value="False" />
            </Trigger>
            <!-- Datei/Ergebnis: Erfolg und Fehler mit Symbol und Text, Taste Schliessen -->
            <Trigger Property="ResultKind" Value="Success">
              <Setter TargetName="ResultOkIcon" Property="Visibility" Value="Visible" />
              <Setter TargetName="BtnCancel" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="BtnConfirm" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="BtnClose" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="ResultKind" Value="Error">
              <Setter TargetName="ResultErrorIcon" Property="Visibility" Value="Visible" />
              <Setter TargetName="MessageBox" Property="Background" Value="{DynamicResource Brush.Status.Error.Subtle}" />
              <Setter TargetName="MessageBox" Property="BorderBrush" Value="{DynamicResource Brush.Status.Error.Fg}" />
              <Setter TargetName="BtnCancel" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="BtnConfirm" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="BtnClose" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
