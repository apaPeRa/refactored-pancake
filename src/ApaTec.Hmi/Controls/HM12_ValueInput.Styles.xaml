<?xml version="1.0" encoding="utf-8"?>
<!-- HM-12 Eingabefeld mit Schluesselsymbol: Stil und ControlTemplate fuer HM12_ValueInput (Button). Antippen loest den Befehl des ViewModels aus (Eingabe-Pop-up).
     Zustaende Normal, Gedrueckt, In Bearbeitung, Fehler, Nicht berechtigt (Schloss), Deaktiviert, Geaendert/nicht geschrieben, ohne Schluessel; zweiter Kanal siehe HM-12. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <local:HM12_HasTextConverter x:Key="HM12.HasText" />
  <local:HM12_ValueTextConverter x:Key="HM12.ValueText" />

  <Style x:Key="HM12.Icon" TargetType="Path">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="Height" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="StrokeThickness" Value="{Binding Source={StaticResource Border.Medium}, Path=Left}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="HM12.Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style TargetType="{x:Type local:HM12_ValueInput}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}" />
    <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Regular}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="Padding" Value="{StaticResource Inset.S}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM12_ValueInput}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LabelText"
                       Grid.Row="0" Grid.Column="0"
                       Text="{TemplateBinding Label}"
                       Foreground="{TemplateBinding Foreground}"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="{StaticResource Inset.S}" />
            <!-- Feld: Flaeche, Kontur, Symbol, Wert mit Einheit, Schluessel/Schloss -->
            <Grid Grid.Row="0" Grid.Column="1">
              <Border x:Name="Face"
                      MinWidth="{StaticResource Size.Button.MinWidth}"
                      MinHeight="{TemplateBinding MinHeight}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{StaticResource Radius.Control}"
                      Padding="{TemplateBinding Padding}">
                <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Path x:Name="FieldIcon"
                        Grid.Column="0"
                        Style="{StaticResource HM12.Icon}"
                        Data="{TemplateBinding Icon}"
                        Stroke="{TemplateBinding Foreground}"
                        Margin="{StaticResource Inset.XS}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{StaticResource Inset.XS}">
                    <TextBlock x:Name="ValueText"
                               Foreground="{TemplateBinding Foreground}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{StaticResource Font.Size.Value}"
                               FontWeight="{StaticResource Font.Weight.Strong}"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center">
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource HM12.ValueText}">
                          <Binding Path="InputKind" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="NumberValue" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="TextValue" RelativeSource="{RelativeSource TemplatedParent}" />
                          <Binding Path="Decimals" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <TextBlock x:Name="UnitText"
                               Text="{Binding Unit, RelativeSource={RelativeSource TemplatedParent}, StringFormat='&#160;{0}'}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{StaticResource Font.Size.Body}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <!-- Berechtigung: Schluessel (berechtigt) oder Schloss (nicht berechtigt), 24 px oben rechts, Farbe primaer -->
                  <Path x:Name="KeyIcon"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        Style="{StaticResource HM12.Icon}"
                        Data="{StaticResource Icon.Key}"
                        Stroke="{DynamicResource Brush.Text.Primary}"
                        VerticalAlignment="Top"
                        Margin="{StaticResource Inset.XS}" />
                  <Path x:Name="LockIcon"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        Style="{StaticResource HM12.Icon}"
                        Data="{StaticResource Icon.Lock}"
                        Stroke="{DynamicResource Brush.Text.Primary}"
                        ToolTip="{res:Loc HM12_PermissionRequired_Hint}"
                        VerticalAlignment="Top"
                        Margin="{StaticResource Inset.XS}" />
                </Grid>
              </Border>
              <Rectangle x:Name="DisabledDash"
                         Visibility="Collapsed"
                         IsHitTestVisible="False"
                         RadiusX="{StaticResource Radius.Control.Size}" RadiusY="{StaticResource Radius.Control.Size}"
                         Stroke="{DynamicResource Brush.Border.Control}"
                         StrokeThickness="{StaticResource Border.Thin.Size}"
                         StrokeDashArray="{StaticResource Border.Dash}" />
            </Grid>
            <!-- Zaehler (Zusatzzaehler, gekoppelter Zaehler) rechts neben dem Feld -->
            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="{StaticResource Inset.S}">
              <TextBlock x:Name="CounterText" Style="{StaticResource HM12.Caption}">
                <Run Text="{Binding Counter, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /><Run Text="{res:Loc HM12_Counter_Unit}" />
              </TextBlock>
              <TextBlock x:Name="CoupledCounterText" Style="{StaticResource HM12.Caption}">
                <Run Text="{Binding CoupledCounter, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /><Run Text="{res:Loc HM12_Counter_Unit}" />
              </TextBlock>
            </StackPanel>
            <!-- Meldungen unter dem Feld: Fehlertext mit Symbol, Hinweis "Nicht geschrieben" mit Symbol -->
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
              <StackPanel x:Name="ErrorRow" Orientation="Horizontal" Visibility="Collapsed" Margin="{StaticResource Inset.XS}">
                <Path Style="{StaticResource HM12.Icon}"
                      Data="{StaticResource Icon.Status.Error}"
                      Stroke="{DynamicResource Brush.Status.Error.Fg}"
                      Margin="{StaticResource Inset.XS}" />
                <TextBlock Style="{StaticResource HM12.Caption}"
                           Text="{TemplateBinding ErrorText}"
                           Foreground="{DynamicResource Brush.Status.Error.Fg}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel x:Name="PendingRow" Orientation="Horizontal" Visibility="Collapsed" Margin="{StaticResource Inset.XS}">
                <Path Style="{StaticResource HM12.Icon}"
                      Data="{StaticResource Icon.State.Pending}"
                      Stroke="{DynamicResource Brush.Text.Secondary}"
                      Margin="{StaticResource Inset.XS}" />
                <TextBlock Style="{StaticResource HM12.Caption}" Text="{res:Loc HM12_NotWritten_Text}" />
              </StackPanel>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Label" Value="">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="FieldIcon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Unit" Value="">
              <Setter TargetName="UnitText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Counter" Value="{x:Null}">
              <Setter TargetName="CounterText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="CoupledCounter" Value="{x:Null}">
              <Setter TargetName="CoupledCounterText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- Geaendert, nicht geschrieben: Punkt-Symbol und Text -->
            <Trigger Property="IsPendingWrite" Value="True">
              <Setter TargetName="PendingRow" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- In Bearbeitung (Pop-up offen) oder Tastaturfokus: Rahmen 3 px Fokusfarbe -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Thick}" />
            </Trigger>
            <Trigger Property="IsEditing" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Thick}" />
            </Trigger>
            <!-- Fehler: Kontur 3 px Fehlerfarbe, Flaeche Subtle, Symbol und Fehlertext -->
            <DataTrigger Binding="{Binding ErrorText, RelativeSource={RelativeSource Self}, Converter={StaticResource HM12.HasText}}" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Status.Error.Subtle}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Status.Error.Fg}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Thick}" />
              <Setter TargetName="ErrorRow" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Pressed}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="RequiresPermission" Value="True" />
                <Condition Property="IsAuthorized" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="KeyIcon" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="RequiresPermission" Value="True" />
                <Condition Property="IsAuthorized" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="LockIcon" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Disabled}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="DisabledDash" Property="Visibility" Value="Visible" />
              <Setter TargetName="UnitText" Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
