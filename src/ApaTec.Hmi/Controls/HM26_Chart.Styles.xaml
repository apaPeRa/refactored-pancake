<?xml version="1.0" encoding="utf-8"?>
<!-- HM-26 Diagramm (Linie / Balken). Zeichnung nur mit WPF-Elementen (Canvas, Path, Rectangle, Ellipse), Skalierung ueber HM26_ChartLayoutConverter.
     Neutral gezeichnet; Statusfarbe nur bei Grenzverletzung, dann zusaetzlich Raute (Linie) bzw. Warnsymbol (Balken). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="HM26.Icon" TargetType="Path">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{Binding Path=Left, Source={StaticResource Border.Medium}}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>

  <!-- Positionierung der Zeichenelemente im Canvas -->
  <Style x:Key="HM26.MarkContainer" TargetType="ContentPresenter">
    <Setter Property="Canvas.Left" Value="{Binding X}" />
    <Setter Property="Canvas.Top" Value="{Binding Y}" />
  </Style>

  <ItemsPanelTemplate x:Key="HM26.CanvasPanel">
    <Canvas />
  </ItemsPanelTemplate>

  <!-- Zeichenelemente -->
  <DataTemplate DataType="{x:Type c:HM26_BarMark}">
    <Rectangle x:Name="Bar" Width="{Binding Width}" Height="{Binding Height}" Fill="{DynamicResource Brush.Progress.Fill}"
               Stroke="{x:Null}" StrokeThickness="{Binding Path=Left, Source={StaticResource Border.Medium}}" />
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsViolation}" Value="True">
        <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Brush.Status.Warning.Fill}" />
        <Setter TargetName="Bar" Property="Stroke" Value="{DynamicResource Brush.Status.Warning.Fg}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate DataType="{x:Type c:HM26_PointMark}">
    <Grid Width="{Binding Width}" Height="{Binding Height}">
      <Ellipse x:Name="Dot" Fill="{DynamicResource Brush.Text.Primary}" />
      <Rectangle x:Name="Diamond" Visibility="Collapsed" Fill="{DynamicResource Brush.Status.Warning.Fill}" Stroke="{DynamicResource Brush.Status.Warning.Fg}"
                 StrokeThickness="{Binding Path=Left, Source={StaticResource Border.Medium}}" RenderTransformOrigin="0.5,0.5">
        <Rectangle.RenderTransform>
          <RotateTransform Angle="45" />
        </Rectangle.RenderTransform>
      </Rectangle>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsViolation}" Value="True">
        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Diamond" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate DataType="{x:Type c:HM26_TextMark}">
    <TextBlock Width="{Binding Width}" Height="{Binding Height}" Text="{Binding Text}" TextAlignment="Center" TextWrapping="NoWrap"
               Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Primary}" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type c:HM26_IconMark}">
    <Viewbox Width="{Binding Width}" Height="{Binding Height}">
      <Path Data="{StaticResource Icon.Status.Warning}" Style="{StaticResource HM26.Icon}" Stroke="{DynamicResource Brush.Status.Warning.Fg}" />
    </Viewbox>
  </DataTemplate>

  <DataTemplate DataType="{x:Type c:HM26_GridLine}">
    <Line x:Name="Rule" X1="0" Y1="0" X2="{Binding Width}" Y2="0" Stroke="{DynamicResource Brush.Divider}"
          StrokeThickness="{StaticResource Border.Thin.Size}" />
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsLimit}" Value="True">
        <Setter TargetName="Rule" Property="Stroke" Value="{DynamicResource Brush.Status.Warning.Fg}" />
        <Setter TargetName="Rule" Property="StrokeThickness" Value="{Binding Path=Left, Source={StaticResource Border.Medium}}" />
        <Setter TargetName="Rule" Property="StrokeDashArray" Value="{StaticResource Border.Dash}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <Style TargetType="{x:Type c:HM26_Chart}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Title, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type c:HM26_Chart}">
          <Grid x:Name="Root" AutomationProperties.HelpText="{Binding Table}">
            <Grid.DataContext>
              <MultiBinding Converter="{x:Static c:HM26_ChartLayoutConverter.Instance}">
                <Binding Path="Series" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="ChartKind" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="YMinimum" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="YMaximum" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="YStep" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="MaxPoints" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="ShowValueLabels" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="LowerLimit" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="UpperLimit" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="XLabels" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="YUnit" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="ActualWidth" ElementName="PlotArea" />
                <Binding Path="ActualHeight" ElementName="PlotArea" />
              </MultiBinding>
            </Grid.DataContext>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Titel und Y-Einheit -->
            <TextBlock x:Name="TitleText" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Text.Value}"
                       Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" Margin="{StaticResource Inset.S}" />

            <!-- Y-Achsenbeschriftung -->
            <Grid Grid.Row="1" Grid.Column="0" Width="{StaticResource Size.Touch.Default}" Margin="{StaticResource Inset.XL}">
              <ItemsControl ItemsSource="{Binding YTicks}" ItemsPanel="{StaticResource HM26.CanvasPanel}" ItemContainerStyle="{StaticResource HM26.MarkContainer}" Focusable="False" />
              <TextBlock x:Name="UnitText" VerticalAlignment="Top" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"
                         Text="{Binding YUnit, RelativeSource={RelativeSource TemplatedParent}}" />
            </Grid>

            <!-- Plotbereich -->
            <Grid x:Name="PlotArea" Grid.Row="1" Grid.Column="1" Margin="{StaticResource Inset.XL}">
                <ItemsControl ItemsSource="{Binding GridLines}" ItemsPanel="{StaticResource HM26.CanvasPanel}" ItemContainerStyle="{StaticResource HM26.MarkContainer}" Focusable="False" />
                <Path x:Name="Trend" Data="{Binding LinePath}" Stroke="{DynamicResource Brush.Text.Primary}"
                      StrokeThickness="{Binding Path=Left, Source={StaticResource Border.Thick}}"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <ItemsControl x:Name="MarkLayer" ItemsSource="{Binding Marks}" ItemsPanel="{StaticResource HM26.CanvasPanel}" ItemContainerStyle="{StaticResource HM26.MarkContainer}" Focusable="False" />

                <!-- Zustand: keine Daten -->
                <StackPanel x:Name="NoData" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Viewbox Width="{StaticResource Size.Icon.M}" Height="{StaticResource Size.Icon.M}">
                    <Path Data="{StaticResource Icon.Status.Inactive}" Style="{StaticResource HM26.Icon}" Stroke="{DynamicResource Brush.Text.Secondary}" />
                  </Viewbox>
                  <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{res:Loc HM26_NoData_Text}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Zustand: laedt -->
                <StackPanel x:Name="Loading" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Viewbox Width="{StaticResource Size.Icon.M}" Height="{StaticResource Size.Icon.M}">
                    <Path Data="{StaticResource Icon.State.Pending}" Style="{StaticResource HM26.Icon}" Stroke="{DynamicResource Brush.Text.Secondary}" />
                  </Viewbox>
                  <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{res:Loc HM26_Loading_Text}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- X-Achsenbeschriftung -->
            <Grid Grid.Row="2" Grid.Column="1" Height="{StaticResource Font.LineHeight.Caption}" Margin="{StaticResource Inset.XL}">
              <ItemsControl ItemsSource="{Binding XTicks}" ItemsPanel="{StaticResource HM26.CanvasPanel}" ItemContainerStyle="{StaticResource HM26.MarkContainer}" Focusable="False" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="{x:Null}">
              <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="YUnit" Value="{x:Null}">
              <Setter TargetName="UnitText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ChartKind" Value="Bar">
              <Setter TargetName="Trend" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding DataContext.HasData, ElementName=Root}" Value="False">
              <Setter TargetName="NoData" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsLoading" Value="True">
              <Setter TargetName="NoData" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Loading" Property="Visibility" Value="Visible" />
              <Setter TargetName="MarkLayer" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Trend" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
