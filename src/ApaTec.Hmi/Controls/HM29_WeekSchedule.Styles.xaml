<?xml version="1.0" encoding="utf-8"?>
<!-- HM-29 Wochen-Zeitplan: sieben Tagesspalten, Kopfzelle mit Plus-Taste (HM-07, mit Schluessel), Eintraege antippbar (oeffnet HM-30).
     Heizphase: durchgezogene Kontur Border.Medium, Symbol Icon.Schedule.Heat und Zeiten im Text. Absenkphase: eingerueckt, gestrichelte Kontur, Icon.Schedule.Setback.
     Unterscheidung nie ueber Farbe (A-54). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:m="clr-namespace:ApaTec.Hmi.Models"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="HM29.Icon" TargetType="Path">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{Binding Path=Left, Source={StaticResource Border.Medium}}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>

  <!-- Eintrag als Taste: Heizphase (Rahmen), Absenkphase (eingerueckt, gestrichelt) -->
  <Style x:Key="HM29.EntryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Margin" Value="{StaticResource Inset.XS}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Host">
            <Border x:Name="Face" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Control}"
                    BorderThickness="{StaticResource Border.Medium}" CornerRadius="{StaticResource Radius.Control}" Padding="{StaticResource Inset.S}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}" VerticalAlignment="Top" Margin="{StaticResource Inset.XS}">
                  <Path x:Name="KindIcon" Data="{StaticResource Icon.Schedule.Heat}" Style="{StaticResource HM29.Icon}" />
                </Viewbox>
                <StackPanel Margin="{StaticResource Inset.XS}">
                  <TextBlock x:Name="StartLine" Style="{StaticResource Text.Body}">
                    <Run Text="{Binding Start, Mode=OneWay, StringFormat='{}{0:HH:mm}'}" />
                    <Run x:Name="StartWord" Text="{res:Loc HM29_Heat_Start}" />
                  </TextBlock>
                  <TextBlock x:Name="EndLine" Style="{StaticResource Text.Body}">
                    <Run Text="{Binding End, Mode=OneWay, StringFormat='{}{0:HH:mm}'}" />
                    <Run x:Name="EndWord" Text="{res:Loc HM29_Heat_End}" />
                  </TextBlock>
                  <StackPanel x:Name="InvalidHint" Orientation="Horizontal" Visibility="Collapsed">
                    <Viewbox Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                      <Path Data="{StaticResource Icon.Status.Error}" Style="{StaticResource HM29.Icon}" Stroke="{DynamicResource Brush.Status.Error.Fg}" />
                    </Viewbox>
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Status.Error.Fg}" Text="{res:Loc HM29_Invalid_Text}" Margin="{StaticResource Inset.XS}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <Rectangle x:Name="DashFrame" Visibility="Collapsed" Stroke="{DynamicResource Brush.Border.Control}"
                       StrokeThickness="{Binding Path=Left, Source={StaticResource Border.Medium}}" StrokeDashArray="{StaticResource Border.Dash}"
                       RadiusX="{StaticResource Radius.Control.Size}" RadiusY="{StaticResource Radius.Control.Size}" />
            <Border x:Name="FocusRing" Visibility="Collapsed" BorderBrush="{DynamicResource Brush.Border.Focus}" BorderThickness="{StaticResource Border.Thick}"
                    CornerRadius="{StaticResource Radius.Control}" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Setback">
              <Setter TargetName="Face" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="DashFrame" Property="Visibility" Value="Visible" />
              <Setter TargetName="Host" Property="Margin" Value="{StaticResource Inset.L}" />
              <Setter TargetName="KindIcon" Property="Data" Value="{StaticResource Icon.Schedule.Setback}" />
              <Setter TargetName="StartWord" Property="Text" Value="{res:Loc HM29_Setback_Start}" />
              <Setter TargetName="EndWord" Property="Text" Value="{res:Loc HM29_Setback_End}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Start}" Value="{x:Null}">
              <Setter TargetName="StartLine" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding End}" Value="{x:Null}">
              <Setter TargetName="EndLine" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsInvalid}" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Status.Error.Fg}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Thick}" />
              <Setter TargetName="InvalidHint" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Pressed}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tagesspalte -->
  <DataTemplate x:Key="HM29.DayColumn" DataType="{x:Type sys:DayOfWeek}">
    <Border Background="{DynamicResource Brush.Surface.Sunken}" BorderBrush="{DynamicResource Brush.Divider}"
            BorderThickness="{StaticResource Border.Thin}" CornerRadius="{StaticResource Radius.Card}" Margin="{StaticResource Inset.XS}" Padding="{StaticResource Inset.S}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Style="{StaticResource Text.Value}" HorizontalAlignment="Center" TextWrapping="NoWrap"
                     Text="{Binding Converter={x:Static c:HM29_DayNameConverter.Instance}}" />
          <c:HM07_ActionButton Icon="{StaticResource Icon.Add}" RequiresPermission="True" Margin="{StaticResource Inset.XS}"
                               IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource AncestorType=c:HM29_WeekSchedule}}"
                               Command="{Binding AddCommand, RelativeSource={RelativeSource AncestorType=c:HM29_WeekSchedule}}"
                               CommandParameter="{Binding}"
                               AutomationProperties.Name="{res:Loc HM29_Add_Name}" ToolTip="{res:Loc HM29_Add_Name}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <ItemsControl Focusable="False">
            <ItemsControl.ItemsSource>
              <MultiBinding Converter="{x:Static c:HM29_DayEntriesConverter.Instance}">
                <Binding Path="Entries" RelativeSource="{RelativeSource AncestorType=c:HM29_WeekSchedule}" />
                <Binding />
              </MultiBinding>
            </ItemsControl.ItemsSource>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type m:ScheduleEntry}">
                <Button Style="{StaticResource HM29.EntryButton}"
                        Command="{Binding EditCommand, RelativeSource={RelativeSource AncestorType=c:HM29_WeekSchedule}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </DataTemplate>

  <Style TargetType="{x:Type c:HM29_WeekSchedule}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AutomationProperties.Name" Value="{res:Loc HM29_Schedule_Name}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type c:HM29_WeekSchedule}">
          <ItemsControl Focusable="False" ItemsSource="{Binding FirstDay, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:HM29_DaysConverter.Instance}}"
                        ItemTemplate="{StaticResource HM29.DayColumn}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
