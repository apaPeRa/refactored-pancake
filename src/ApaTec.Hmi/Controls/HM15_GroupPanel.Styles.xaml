<?xml version="1.0" encoding="utf-8"?>
<!-- HM-15 Gruppenbereich: Panel (vertiefte Flaeche, Radius.Card, Innenabstand Space.M) oder Ueberschrift-Variante (Text mit Linie Brush.Divider, keine Unterstreichung).
     Hervorhebung: Kontur Border.Thick Brush.Border.Focus plus Symbol und Text „Ausgewaehlt“ (zweiter Kanal). Keine feste Groesse. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="HM15_IconPath" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Size.Icon.Stroke}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>

  <Style TargetType="{x:Type local:HM15_GroupPanel}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM15_GroupPanel}">
          <Border x:Name="Surface"
                  Background="{DynamicResource Brush.Surface.Sunken}"
                  BorderBrush="{DynamicResource Brush.Divider}"
                  BorderThickness="{StaticResource Border.Thin}"
                  CornerRadius="{StaticResource Radius.Card}"
                  Padding="{StaticResource Inset.M}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- Ueberschrift und Hervorhebung -->
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="HeaderHost" ContentSource="Header" VerticalAlignment="Center">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Value}" />
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <StackPanel x:Name="HighlightMark" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                  <Viewbox Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}" VerticalAlignment="Center">
                    <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                      <Path Style="{StaticResource HM15_IconPath}" Stroke="{DynamicResource Brush.Border.Focus}" Data="{StaticResource Icon.State.On}" />
                    </Grid>
                  </Viewbox>
                  <TextBlock x:Name="HighlightDefault" Style="{StaticResource Text.Caption}" Text="{res:Loc HM15_Highlight_Text}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center" Visibility="Collapsed" />
                  <TextBlock x:Name="HighlightCustom" Style="{StaticResource Text.Caption}" Text="{TemplateBinding HighlightText}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <!-- Trennlinie der Ueberschrift-Variante -->
              <Rectangle x:Name="HeadingLine" Grid.Row="1" Visibility="Collapsed"
                         Height="{StaticResource Border.Thin.Size}"
                         Margin="{StaticResource Inset.XS}"
                         Fill="{DynamicResource Brush.Divider}" />

              <!-- Zwischenueberschrift: reiner Text -->
              <TextBlock x:Name="SubheaderText" Grid.Row="2" Style="{StaticResource Text.Body}" Text="{TemplateBinding Subheader}" Margin="{StaticResource Inset.XS}" />

              <ContentPresenter Grid.Row="3" ContentSource="Content" Margin="{StaticResource Inset.XS}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Subheader" Value="{x:Null}">
              <Setter TargetName="SubheaderText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="GroupStyle" Value="Heading">
              <Setter TargetName="Surface" Property="Background" Value="Transparent" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="Surface" Property="Padding" Value="{StaticResource Inset.XS}" />
              <Setter TargetName="HeadingLine" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
              <Setter TargetName="Surface" Property="BorderThickness" Value="{StaticResource Border.Thick}" />
              <Setter TargetName="HighlightMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsHighlighted" Value="True" />
                <Condition Property="HighlightText" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="HighlightDefault" Property="Visibility" Value="Visible" />
              <Setter TargetName="HighlightCustom" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
