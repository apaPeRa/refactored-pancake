<?xml version="1.0" encoding="utf-8"?>
<!-- HM-18 Auswahlfeld mit Pfeiltasten: zwei Pfeiltasten (Size.Touch.Default x Size.Touch.Default, Icon.Chevron links gespiegelt) und eine Anzeige (Font.Size.Value).
     Am Listenende: Pfeiltaste deaktiviert (gestrichelt, Basisvorlage Button), gesteuert ueber CanExecute der Befehle. Nicht uebernommen: Icon.State.Pending + Text. Berechtigung: Icon.Key / Icon.Lock.
     Direkteingabe: Anzeige ist antippbar (DirectEntryCommand), sonst nur Anzeige. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="HM18_IconPath" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{Binding Source={StaticResource Border.Medium}, Path=Left}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>

  <Style x:Key="HM18_ArrowButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="Height" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="Margin" Value="{StaticResource Inset.S}" />
    <Setter Property="Padding" Value="{StaticResource Inset.S}" />
  </Style>

  <Style x:Key="HM18_DisplayStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Value}" />
    <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Strong}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.Button.MinWidth}" />
    <Setter Property="Margin" Value="{StaticResource Inset.S}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style TargetType="{x:Type local:HM18_SelectorField}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM18_SelectorField}">
          <StackPanel>
            <TextBlock x:Name="LabelText" Style="{StaticResource Text.Caption}" Text="{TemplateBinding Label}" Margin="{StaticResource Inset.S}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Button x:Name="PreviousButton" Grid.Column="0"
                      Style="{StaticResource HM18_ArrowButtonStyle}"
                      Command="{TemplateBinding PreviousCommand}"
                      AutomationProperties.Name="{res:Loc HM18_Previous_Name}">
                <Viewbox Width="{StaticResource Size.Icon.M}" Height="{StaticResource Size.Icon.M}" RenderTransformOrigin="0.5,0.5">
                  <Viewbox.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                  </Viewbox.RenderTransform>
                  <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                    <Path Style="{StaticResource HM18_IconPath}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="{StaticResource Icon.Chevron}" />
                  </Grid>
                </Viewbox>
              </Button>

              <Button x:Name="DisplayButton" Grid.Column="1"
                      Style="{StaticResource HM18_DisplayStyle}"
                      Command="{TemplateBinding DirectEntryCommand}"
                      Content="{TemplateBinding DisplayText}" />
              <!-- Berechtigung: Schluessel (berechtigt) bzw. Schloss (gesperrt), rechts in der Anzeige -->
              <Viewbox x:Name="KeyIcon" Grid.Column="1" Visibility="Collapsed" IsHitTestVisible="False"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{StaticResource Inset.M}"
                       Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                  <Path Style="{StaticResource HM18_IconPath}" Data="{StaticResource Icon.Key}" />
                </Grid>
              </Viewbox>
              <Viewbox x:Name="LockIcon" Grid.Column="1" Visibility="Collapsed" IsHitTestVisible="False"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{StaticResource Inset.M}"
                       Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                  <Path Style="{StaticResource HM18_IconPath}" Data="{StaticResource Icon.Lock}" />
                </Grid>
              </Viewbox>

              <Button x:Name="NextButton" Grid.Column="2"
                      Style="{StaticResource HM18_ArrowButtonStyle}"
                      Command="{TemplateBinding NextCommand}"
                      AutomationProperties.Name="{res:Loc HM18_Next_Name}">
                <Viewbox Width="{StaticResource Size.Icon.M}" Height="{StaticResource Size.Icon.M}">
                  <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                    <Path Style="{StaticResource HM18_IconPath}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="{StaticResource Icon.Chevron}" />
                  </Grid>
                </Viewbox>
              </Button>
            </Grid>
            <!-- Ausgewaehlt, nicht uebernommen: Symbol und Text -->
            <StackPanel x:Name="PendingMark" Orientation="Horizontal" Visibility="Collapsed" HorizontalAlignment="Center" Margin="{StaticResource Inset.S}">
              <Viewbox Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}" VerticalAlignment="Center">
                <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                  <Path Style="{StaticResource HM18_IconPath}" Stroke="{DynamicResource Brush.Status.Warning.Fg}" Data="{StaticResource Icon.State.Pending}" />
                </Grid>
              </Viewbox>
              <TextBlock Style="{StaticResource Text.Caption}" Text="{res:Loc HM18_Pending_Text}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Label" Value="{x:Null}">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="AllowDirectEntry" Value="False">
              <Setter TargetName="DisplayButton" Property="IsHitTestVisible" Value="False" />
              <Setter TargetName="DisplayButton" Property="Focusable" Value="False" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="RequiresPermission" Value="True" />
                <Condition Property="IsAuthorized" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="KeyIcon" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="RequiresPermission" Value="True" />
                <Condition Property="IsAuthorized" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="LockIcon" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="RequiresApply" Value="True" />
                <Condition Property="IsPending" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PendingMark" Property="Visibility" Value="Visible" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
