<?xml version="1.0" encoding="utf-8"?>
<!-- HM-27 Hinweis-Textfeld. Art immer ueber Symbol und Wort (zweiter Kanal), Flaeche und Kontur nach Statusfarbe. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style TargetType="{x:Type c:HM27_NoticeBox}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Min}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type c:HM27_NoticeBox}">
          <Border x:Name="Frame" MinHeight="{TemplateBinding MinHeight}"
                  Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border.Control}"
                  BorderThickness="{StaticResource Border.Thin}" CornerRadius="{StaticResource Radius.Control}"
                  Padding="{StaticResource Inset.S}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- Symbol mit Wort in Caption-Schrift darunter; der Text behaelt die volle Restbreite (S-13) -->
              <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Viewbox x:Name="IconBox" Width="{StaticResource Size.Icon.M}" Height="{StaticResource Size.Icon.M}"
                       Margin="{StaticResource Inset.XS}" HorizontalAlignment="Center">
                <Path x:Name="Glyph" Data="{TemplateBinding Icon}" Stretch="Uniform"
                      Stroke="{DynamicResource Brush.Text.Primary}"
                      StrokeThickness="{StaticResource Size.Icon.Stroke}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Viewbox>
              <TextBlock x:Name="Word" Visibility="Collapsed" Style="{StaticResource Text.Caption}"
                         FontWeight="{StaticResource Font.Weight.Strong}" Foreground="{DynamicResource Brush.Text.Primary}"
                         HorizontalAlignment="Center" TextWrapping="NoWrap" />
              </StackPanel>
              <Grid Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource Inset.S}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CaptionPart" Grid.Column="0" Style="{StaticResource Text.Body}" TextWrapping="NoWrap"
                           FontWeight="{StaticResource Font.Weight.Strong}" Margin="{StaticResource Inset.XS}"
                           Text="{Binding Caption, RelativeSource={RelativeSource TemplatedParent}}" />
                <TextBlock x:Name="TextPart" Grid.Column="1" Style="{StaticResource Text.Body}" Margin="{StaticResource Inset.XS}"
                           Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Caption" Value="{x:Null}">
              <Setter TargetName="CaptionPart" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="MessageLine" />
                <Condition Property="Severity" Value="None" />
                <Condition Property="Icon" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <Trigger Property="Kind" Value="Info">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.Status.Info.Subtle}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Status.Info.Fg}" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="{StaticResource Border.Thin}" />
              <Setter TargetName="Word" Property="Visibility" Value="Visible" />
              <Setter TargetName="Word" Property="Text" Value="{res:Loc Status_Info_Word}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="Info" />
                <Condition Property="Icon" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Status.Info}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.Status.Info.Fg}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="MessageLine" />
                <Condition Property="Severity" Value="Info" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.Status.Info.Subtle}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Status.Info.Fg}" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="{StaticResource Border.Thin}" />
              <Setter TargetName="Word" Property="Visibility" Value="Visible" />
              <Setter TargetName="Word" Property="Text" Value="{res:Loc Status_Info_Word}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="MessageLine" />
                <Condition Property="Severity" Value="Info" />
                <Condition Property="Icon" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Status.Info}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.Status.Info.Fg}" />
            </MultiTrigger>
            <Trigger Property="Kind" Value="Warning">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.Status.Warning.Subtle}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Status.Warning.Fg}" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
              <Setter TargetName="Word" Property="Visibility" Value="Visible" />
              <Setter TargetName="Word" Property="Text" Value="{res:Loc Status_Warning_Word}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="Warning" />
                <Condition Property="Icon" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Status.Warning}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.Status.Warning.Fg}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="MessageLine" />
                <Condition Property="Severity" Value="Warning" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.Status.Warning.Subtle}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Status.Warning.Fg}" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
              <Setter TargetName="Word" Property="Visibility" Value="Visible" />
              <Setter TargetName="Word" Property="Text" Value="{res:Loc Status_Warning_Word}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="MessageLine" />
                <Condition Property="Severity" Value="Warning" />
                <Condition Property="Icon" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Status.Warning}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.Status.Warning.Fg}" />
            </MultiTrigger>
            <Trigger Property="Kind" Value="Error">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.Status.Error.Subtle}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Status.Error.Fg}" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="{StaticResource Border.Thick}" />
              <Setter TargetName="Word" Property="Visibility" Value="Visible" />
              <Setter TargetName="Word" Property="Text" Value="{res:Loc Status_Error_Word}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="Error" />
                <Condition Property="Icon" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Status.Error}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.Status.Error.Fg}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="MessageLine" />
                <Condition Property="Severity" Value="Error" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.Status.Error.Subtle}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Status.Error.Fg}" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="{StaticResource Border.Thick}" />
              <Setter TargetName="Word" Property="Visibility" Value="Visible" />
              <Setter TargetName="Word" Property="Text" Value="{res:Loc Status_Error_Word}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="MessageLine" />
                <Condition Property="Severity" Value="Error" />
                <Condition Property="Icon" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Status.Error}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.Status.Error.Fg}" />
            </MultiTrigger>
            <!-- Meldungszeile leer: Text „–“ -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Kind" Value="MessageLine" />
                <Condition Property="Text" Value="" />
              </MultiTrigger.Conditions>
              <Setter TargetName="TextPart" Property="Text" Value="{res:Loc HM27_Empty_Text}" />
              <Setter TargetName="TextPart" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            </MultiTrigger>
            <Trigger Property="IsShown" Value="False">
              <Setter TargetName="Frame" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
