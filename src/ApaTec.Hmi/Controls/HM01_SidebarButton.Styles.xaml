<?xml version="1.0" encoding="utf-8"?>
<!-- HM-01 Seitenleisten-Eintrag (HM01_SidebarButton): Symbol (Size.Icon.L) mit Kurzbeschriftung, Hoehe Size.Touch.Large.
     Zustaende (zweiter Kanal): aktuelle Seite = Balken links (Size.SelectionBar) + Grund Brush.Sidebar.Selected; gedrueckt = Border.Medium;
     deaktiviert/gesperrt = gestrichelte Kontur (Border.Dash); neue Meldungen = Zaehler-Punkt mit Zahl. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls">

  <!-- Symbolstrich im 24er-Raster (Strichstaerke 2 = Border.Medium, runde Enden) -->
  <Style x:Key="HM01_IconPath" TargetType="Path">
    <Setter Property="StrokeThickness" Value="{Binding Source={StaticResource Border.Medium}, Path=Left}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>

  <Style TargetType="{x:Type local:HM01_SidebarButton}">
    <Setter Property="Height" Value="{StaticResource Size.Touch.Large}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM01_SidebarButton}">
          <ControlTemplate.Resources>
            <local:HM01_BadgeTextConverter x:Key="BadgeText" />
          </ControlTemplate.Resources>
          <Grid>
            <Border x:Name="Face"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="{StaticResource Border.Thin}" />
            <!-- Auswahlbalken am linken Rand (Form als zweiter Kanal) -->
            <Rectangle x:Name="SelectionBar"
                       Visibility="Collapsed"
                       HorizontalAlignment="Left"
                       Width="{StaticResource Size.SelectionBar}"
                       Fill="{DynamicResource Brush.Sidebar.Text}" />
            <!-- Deaktiviert: gestrichelte Kontur -->
            <Rectangle x:Name="DisabledDash"
                       Visibility="Collapsed"
                       Stroke="{DynamicResource Brush.Sidebar.Text.Secondary}"
                       StrokeThickness="{StaticResource Border.Thin.Size}"
                       StrokeDashArray="{StaticResource Border.Dash}" />
            <Border x:Name="FocusRing"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                    BorderThickness="{StaticResource Border.Thick}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid HorizontalAlignment="Center">
                <Viewbox Width="{StaticResource Size.Icon.L}" Height="{StaticResource Size.Icon.L}">
                  <Grid>
                    <Path Data="M0,0 H24 V24 H0 Z" Fill="Transparent" />
                    <Path x:Name="IconPath"
                          Style="{StaticResource HM01_IconPath}"
                          Data="{TemplateBinding Icon}"
                          Stroke="{DynamicResource Brush.Sidebar.Text}" />
                  </Grid>
                </Viewbox>
                <!-- Zaehler-Punkt neue Meldungen: Zahl im Punkt, Kontur Border.Medium -->
                <Border x:Name="Badge"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        MinWidth="{StaticResource Size.Icon.S}" MinHeight="{StaticResource Size.Icon.S}"
                        Background="{DynamicResource Brush.Status.Warning.Fill}"
                        BorderBrush="{DynamicResource Brush.Status.Warning.Fg}"
                        BorderThickness="{StaticResource Border.Medium}"
                        CornerRadius="{StaticResource Radius.Pill}">
                  <TextBlock Style="{StaticResource Text.Caption}"
                             Foreground="{DynamicResource Brush.Status.Warning.On}"
                             FontWeight="{StaticResource Font.Weight.Strong}"
                             TextWrapping="NoWrap"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Text="{Binding BadgeCount, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BadgeText}}" />
                </Border>
              </Grid>
              <TextBlock x:Name="Caption"
                         Style="{StaticResource Text.Caption}"
                         Foreground="{DynamicResource Brush.Sidebar.Text.Secondary}"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         TextAlignment="Center"
                         Text="{TemplateBinding Label}" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="BadgeCount" Value="0">
              <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsCurrent" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Sidebar.Selected}" />
              <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Sidebar.Selected}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Sidebar.Text}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
            </Trigger>
            <Trigger Property="IsDimmed" Value="True">
              <Setter TargetName="DisabledDash" Property="Visibility" Value="Visible" />
              <Setter TargetName="IconPath" Property="Stroke" Value="{DynamicResource Brush.Sidebar.Text.Secondary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="DisabledDash" Property="Visibility" Value="Visible" />
              <Setter TargetName="IconPath" Property="Stroke" Value="{DynamicResource Brush.Sidebar.Text.Secondary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
