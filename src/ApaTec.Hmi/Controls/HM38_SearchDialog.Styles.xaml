<?xml version="1.0" encoding="utf-8"?>
<!-- HM38_SearchDialog.Styles.xaml: Template des Such-Pop-ups (HM-38), Inhalt von HM14_PopupFrame: Suchzeile, Trefferliste, Scrolltasten (HM-07), Abbrechen. Keine Logik. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Symbolpfad im 24er-Raster; Strichstaerke aus dem Token Border.Medium -->
  <Style x:Key="HM38.Icon" TargetType="Path">
    <Setter Property="Width" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="Height" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{Binding Source={StaticResource Border.Medium}, Path=Left}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Trefferzeile: Kennzeichnung, Bezeichnung, Gruppe; gedrueckt Brush.Button.Pressed mit Border.Medium -->
  <Style x:Key="HM38_HitButton" TargetType="Button">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Min}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Face"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Divider}"
                    BorderThickness="{StaticResource Border.Thin}"
                    Padding="{StaticResource Inset.S}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*" />
                  <ColumnDefinition Width="6*" />
                  <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                           FontWeight="{StaticResource Font.Weight.Strong}" Text="{Binding Identifier}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                           Text="{Binding Description}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding Group}" />
              </Grid>
            </Border>
            <Border x:Name="FocusRing" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                    BorderThickness="{StaticResource Border.Thick}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Pressed}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:HM38_SearchDialog}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM38_SearchDialog}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Suchzeile: Fokusrahmen Border.Thick, Platzhalter, Loeschen -->
            <Border Grid.Row="0" Margin="{StaticResource Inset.XS}"
                    MinHeight="{StaticResource Size.Touch.Default}"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                    BorderThickness="{StaticResource Border.Thick}"
                    CornerRadius="{StaticResource Radius.Control}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0"
                         MaxLength="40"
                         VerticalContentAlignment="Center"
                         Padding="{StaticResource Inset.S}"
                         FontSize="{StaticResource Font.Size.Body}"
                         Foreground="{DynamicResource Brush.Text.Primary}"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock x:Name="PlaceholderText" Grid.Column="0" IsHitTestVisible="False"
                           Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                           Margin="{StaticResource Inset.M}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Visibility="Collapsed"
                           Text="{TemplateBinding Placeholder}" />
                <Button Grid.Column="1" Margin="{StaticResource Inset.XS}"
                        MinWidth="{StaticResource Size.Touch.Min}"
                        Command="{TemplateBinding ClearTextCommand}"
                        AutomationProperties.Name="{res:Loc HM38_Clear_Label}">
                  <Path Style="{StaticResource HM38.Icon}" Data="{StaticResource Icon.Close}" />
                </Button>
              </Grid>
            </Border>
            <!-- Trefferliste mit Scrolltasten -->
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ScrollViewer Grid.Column="0" Margin="{StaticResource Inset.XS}"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            CanContentScroll="True"
                            PanningMode="VerticalOnly">
                <ItemsControl x:Name="HitList" Focusable="False"
                              ItemsSource="{TemplateBinding FilteredItems}"
                              VirtualizingPanel.IsVirtualizing="True"
                              ScrollViewer.CanContentScroll="True">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SearchHit}">
                      <Button Style="{StaticResource HM38_HitButton}"
                              Command="{Binding SelectHitCommand, RelativeSource={RelativeSource AncestorType={x:Type local:HM38_SearchDialog}}}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <!-- Kein Treffer: Symbol Icon.Status.Info und Text -->
              <StackPanel x:Name="EmptyPanel" Grid.Column="0" Visibility="Collapsed"
                          Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Margin="{StaticResource Inset.L}">
                <Path Style="{StaticResource HM38.Icon}" Data="{StaticResource Icon.Status.Info}"
                      Stroke="{DynamicResource Brush.Status.Info.Fg}" />
                <TextBlock x:Name="EmptyDefault" Style="{StaticResource Text.Body}" Margin="{StaticResource Inset.S}"
                           VerticalAlignment="Center" Visibility="Collapsed" Text="{res:Loc HM38_Empty_Text}" />
                <TextBlock x:Name="EmptyCustom" Style="{StaticResource Text.Body}" Margin="{StaticResource Inset.S}"
                           VerticalAlignment="Center" Text="{TemplateBinding EmptyText}" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="{StaticResource Inset.XS}">
                <local:HM07_ActionButton Margin="{StaticResource Inset.XS}"
                                         Icon="{StaticResource Icon.Scroll.Up}"
                                         Label="{res:Loc HM38_ScrollUp_Label}"
                                         Command="{TemplateBinding ScrollUpCommand}" />
                <local:HM07_ActionButton Margin="{StaticResource Inset.XS}"
                                         Icon="{StaticResource Icon.Scroll.Down}"
                                         Label="{res:Loc HM38_ScrollDown_Label}"
                                         Command="{TemplateBinding ScrollDownCommand}" />
              </StackPanel>
            </Grid>
            <!-- Abbrechen -->
            <local:HM07_ActionButton Grid.Row="2" HorizontalAlignment="Right" Margin="{StaticResource Inset.XS}"
                                     Label="{res:Loc HM38_Cancel_Label}"
                                     Command="{TemplateBinding CancelCommand}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger SourceName="SearchBox" Property="Text" Value="">
              <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="EmptyText" Value="{x:Null}">
              <Setter TargetName="EmptyDefault" Property="Visibility" Value="Visible" />
              <Setter TargetName="EmptyCustom" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="FilteredItems" Value="{x:Null}">
              <Setter TargetName="EmptyPanel" Property="Visibility" Value="Visible" />
            </Trigger>
            <DataTrigger Binding="{Binding FilteredItems.Count, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
              <Setter TargetName="EmptyPanel" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
