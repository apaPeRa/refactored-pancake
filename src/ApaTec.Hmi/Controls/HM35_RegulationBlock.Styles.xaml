<?xml version="1.0" encoding="utf-8"?>
<!-- HM35_RegulationBlock.Styles.xaml: Template des Regulierungs-Parameterblocks (HM-35), Komposit aus HM-15, HM-12, HM-11, HM-08, HM-07. Keine Logik. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Symbolpfad im 24er-Raster; Strichstaerke aus dem Token Border.Medium -->
  <Style x:Key="HM35.Icon" TargetType="Path">
    <Setter Property="Width" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="Height" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{Binding Source={StaticResource Border.Medium}, Path=Left}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style TargetType="{x:Type local:HM35_RegulationBlock}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM35_RegulationBlock}">
          <local:HM15_GroupPanel Header="{TemplateBinding Title}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <!-- Linke Spalte: fuenf Eingabefelder -->
              <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
              <local:HM12_ValueInput Grid.Row="0" Margin="{StaticResource Inset.XS}"
                                     Label="{res:Loc HM35_SampleCount_Label}"
                                     InputKind="Number" Decimals="0"
                                     Unit="{res:Loc HM35_Count_Unit}"
                                     RequiresPermission="True"
                                     IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}"
                                     NumberValue="{Binding SampleCount, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              <local:HM12_ValueInput Grid.Row="1" Margin="{StaticResource Inset.XS}"
                                     Label="{res:Loc HM35_Step_Label}"
                                     InputKind="Number" Decimals="1"
                                     Unit="{res:Loc HM35_Percent_Unit}"
                                     RequiresPermission="True"
                                     IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}"
                                     NumberValue="{Binding Step, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              <local:HM12_ValueInput Grid.Row="2" Margin="{StaticResource Inset.XS}"
                                     Label="{res:Loc HM35_Tolerance_Label}"
                                     InputKind="Number" Decimals="1"
                                     Unit="{res:Loc HM35_Gram_Unit}"
                                     RequiresPermission="True"
                                     IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}"
                                     NumberValue="{Binding Tolerance, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              <local:HM12_ValueInput Grid.Row="3" Margin="{StaticResource Inset.XS}"
                                     Label="{res:Loc HM35_MaxCorrection_Label}"
                                     InputKind="Number" Decimals="1"
                                     Unit="{res:Loc HM35_Gram_Unit}"
                                     RequiresPermission="True"
                                     IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}"
                                     NumberValue="{Binding MaxCorrection, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              <local:HM12_ValueInput Grid.Row="4" Margin="{StaticResource Inset.XS}"
                                     Label="{res:Loc HM35_CurrentCorrection_Label}"
                                     InputKind="Number" Decimals="1"
                                     Unit="{res:Loc HM35_Gram_Unit}"
                                     RequiresPermission="True"
                                     IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}"
                                     NumberValue="{Binding CurrentCorrection, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              </Grid>
              <!-- Rechte Spalte: Mittelwert mit Zaehler, Umschalter, Handeingriff -->
              <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:HM11_ValueDisplay Grid.Row="0" Margin="{StaticResource Inset.XS}"
                                         Label="{res:Loc HM35_Mean_Label}"
                                         ValueKind="Number" Decimals="1"
                                         Unit="{res:Loc HM35_Gram_Unit}"
                                         NumberValue="{Binding Mean, RelativeSource={RelativeSource TemplatedParent}}" />
                <!-- Zaehler als Text: "11 von 15" -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{StaticResource Inset.XS}">
                  <TextBlock Style="{StaticResource Text.Body}" Text="{Binding MeanCount, RelativeSource={RelativeSource TemplatedParent}}" />
                  <TextBlock Style="{StaticResource Text.Body}" Margin="{StaticResource Inset.XS}" Text="{res:Loc HM35_MeanCount_Of}" />
                  <TextBlock Style="{StaticResource Text.Body}" Text="{Binding SampleCount, RelativeSource={RelativeSource TemplatedParent}}" />
                </StackPanel>
                <!-- Korrektur am Limit: Warnung mit Symbol und Text -->
                <Border x:Name="LimitNotice" Grid.Row="2" Visibility="Collapsed"
                        Margin="{StaticResource Inset.XS}" Padding="{StaticResource Inset.S}"
                        Background="{DynamicResource Brush.Status.Warning.Subtle}"
                        BorderBrush="{DynamicResource Brush.Status.Warning.Fg}"
                        BorderThickness="{StaticResource Border.Medium}"
                        CornerRadius="{StaticResource Radius.Control}">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource HM35.Icon}"
                          Data="{StaticResource Icon.Status.Warning}"
                          Stroke="{DynamicResource Brush.Status.Warning.Fg}" />
                    <TextBlock Style="{StaticResource Text.Body}" Margin="{StaticResource Inset.S}"
                               VerticalAlignment="Center" Text="{res:Loc HM35_Limit_Text}" />
                  </StackPanel>
                </Border>
                <local:HM08_ToggleSwitch Grid.Row="3" Margin="{StaticResource Inset.XS}"
                                         Label="{res:Loc HM35_Regulation_Label}"
                                         RequiresPermission="True"
                                         IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}"
                                         IsChecked="{Binding IsRegulationOn, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                         ToggleCommand="{TemplateBinding ToggleCommand}" />
                <Grid Grid.Row="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <local:HM07_ActionButton Grid.Column="0" Margin="{StaticResource Inset.XS}"
                                           Label="{res:Loc HM35_Decrease_Label}"
                                           Icon="{StaticResource Icon.Jog.Minus}"
                                           RequiresPermission="True"
                                           IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}"
                                           Command="{TemplateBinding DecreaseCommand}" />
                  <local:HM07_ActionButton Grid.Column="1" Margin="{StaticResource Inset.XS}"
                                           Label="{res:Loc HM35_Increase_Label}"
                                           Icon="{StaticResource Icon.Jog.Plus}"
                                           RequiresPermission="True"
                                           IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}"
                                           Command="{TemplateBinding IncreaseCommand}" />
                </Grid>
              </Grid>
            </Grid>
          </local:HM15_GroupPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsAtLimit" Value="True">
              <Setter TargetName="LimitNotice" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
