<?xml version="1.0" encoding="utf-8"?>
<!-- HM21_MotorParameterCard.Styles.xaml: Template der Motorparameter-Karte (HM-21), Rahmen HM-15, Zeilen HM-12. Keine Logik, keine Literale. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <local:HM21_FieldErrorConverter x:Key="HM21.FieldError" />

  <Style x:Key="HM21.IconPath" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Size.Icon.Stroke}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>

  <Style TargetType="{x:Type local:HM21_MotorParameterCard}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM21_MotorParameterCard}">
          <Grid>
            <local:HM15_GroupPanel Header="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" Subheader="{Binding DoserName, RelativeSource={RelativeSource TemplatedParent}}">
              <StackPanel>
                <!-- Verschluss: Position und Geschwindigkeit (bei Schnecke ausgeblendet) -->
                <StackPanel x:Name="ClosureRows">
                  <local:HM12_ValueInput Margin="{StaticResource Inset.XS}" Label="{res:Loc HM21_Position_Label}" ToolTip="{res:Loc HM21_Position_Help}"
                                         NumberValue="{Binding Position, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Command="{Binding EditCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="Position" Unit="{res:Loc Unit_Degree}" Decimals="0"  IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}">
                    <local:HM12_ValueInput.ErrorText>
                      <MultiBinding Converter="{StaticResource HM21.FieldError}" ConverterParameter="Position">
                        <Binding Path="ErrorField" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="ErrorText" RelativeSource="{RelativeSource TemplatedParent}" />
                      </MultiBinding>
                    </local:HM12_ValueInput.ErrorText>
                  </local:HM12_ValueInput>
                  <local:HM12_ValueInput Margin="{StaticResource Inset.XS}" Label="{res:Loc HM21_Speed_Label}" ToolTip="{res:Loc HM21_Speed_Help}"
                                         NumberValue="{Binding Speed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Command="{Binding EditCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="Speed" Unit="{res:Loc Unit_Percent}" Decimals="0"  IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}">
                    <local:HM12_ValueInput.ErrorText>
                      <MultiBinding Converter="{StaticResource HM21.FieldError}" ConverterParameter="Speed">
                        <Binding Path="ErrorField" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="ErrorText" RelativeSource="{RelativeSource TemplatedParent}" />
                      </MultiBinding>
                    </local:HM12_ValueInput.ErrorText>
                  </local:HM12_ValueInput>
                </StackPanel>
                <local:HM12_ValueInput Margin="{StaticResource Inset.XS}" Label="{res:Loc HM21_Acceleration_Label}" ToolTip="{res:Loc HM21_Acceleration_Help}"
                                       NumberValue="{Binding Acceleration, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Command="{Binding EditCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="Acceleration" Unit="{res:Loc Unit_Percent}" Decimals="0"  IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}">
                    <local:HM12_ValueInput.ErrorText>
                      <MultiBinding Converter="{StaticResource HM21.FieldError}" ConverterParameter="Acceleration">
                        <Binding Path="ErrorField" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="ErrorText" RelativeSource="{RelativeSource TemplatedParent}" />
                      </MultiBinding>
                    </local:HM12_ValueInput.ErrorText>
                  </local:HM12_ValueInput>
                <local:HM12_ValueInput Margin="{StaticResource Inset.XS}" Label="{res:Loc HM21_Deceleration_Label}" ToolTip="{res:Loc HM21_Deceleration_Help}"
                                       NumberValue="{Binding Deceleration, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Command="{Binding EditCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="Deceleration" Unit="{res:Loc Unit_Percent}" Decimals="0"  IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}">
                    <local:HM12_ValueInput.ErrorText>
                      <MultiBinding Converter="{StaticResource HM21.FieldError}" ConverterParameter="Deceleration">
                        <Binding Path="ErrorField" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="ErrorText" RelativeSource="{RelativeSource TemplatedParent}" />
                      </MultiBinding>
                    </local:HM12_ValueInput.ErrorText>
                  </local:HM12_ValueInput>
                <local:HM12_ValueInput Margin="{StaticResource Inset.XS}" Label="{res:Loc HM21_Jerk_Label}" ToolTip="{res:Loc HM21_Jerk_Help}"
                                       NumberValue="{Binding Jerk, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Command="{Binding EditCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="Jerk" Unit="{res:Loc Unit_Percent}" Decimals="0"  IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}">
                    <local:HM12_ValueInput.ErrorText>
                      <MultiBinding Converter="{StaticResource HM21.FieldError}" ConverterParameter="Jerk">
                        <Binding Path="ErrorField" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="ErrorText" RelativeSource="{RelativeSource TemplatedParent}" />
                      </MultiBinding>
                    </local:HM12_ValueInput.ErrorText>
                  </local:HM12_ValueInput>
              </StackPanel>
            </local:HM15_GroupPanel>
            <!-- Schnecken-Symbol neben der Ueberschrift (nur Kartenart Schnecke) -->
            <Viewbox x:Name="ScrewIcon" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{StaticResource Inset.M}"
                     Width="{StaticResource Size.Icon.L}" Height="{StaticResource Size.Icon.L}">
              <Path Style="{StaticResource HM21.IconPath}" Data="{StaticResource Icon.Motor.Screw}" />
            </Viewbox>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="CardKind" Value="Screw">
              <Setter TargetName="ClosureRows" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="ScrewIcon" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
