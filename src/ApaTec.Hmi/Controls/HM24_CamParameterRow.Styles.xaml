<?xml version="1.0" encoding="utf-8"?>
<!-- HM24_CamParameterRow.Styles.xaml: Template der Nocken-Parameterzeile (HM-24): Beschriftung, Winkel/Zeit (HM-12 mit Schluessel), Ergebnis (HM-11).
     Felder ohne Wert (null) entfallen; "Nicht geschrieben" mit Icon.State.Pending. Keine Logik, keine Literale. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="HM24.IconPath" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Size.Icon.Stroke}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>


  <Style TargetType="{x:Type local:HM24_CamParameterRow}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM24_CamParameterRow}">
          <Grid Margin="{StaticResource Inset.XS}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.Value}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center"
                       Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" />
            <local:HM12_ValueInput x:Name="AngleField" Grid.Row="0" Grid.Column="1" Margin="{StaticResource Inset.XS}"
                                   NumberValue="{Binding Angle, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Unit="°" Decimals="0" RequiresPermission="True" IsPendingWrite="{Binding IsPendingWrite, RelativeSource={RelativeSource TemplatedParent}}"
                                   IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}" Command="{Binding EditAngleCommand, RelativeSource={RelativeSource TemplatedParent}}" />
            <local:HM12_ValueInput x:Name="TimeField" Grid.Row="0" Grid.Column="2" Margin="{StaticResource Inset.XS}"
                                   NumberValue="{Binding Time, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Unit="ms" Decimals="0" RequiresPermission="True" IsPendingWrite="{Binding IsPendingWrite, RelativeSource={RelativeSource TemplatedParent}}"
                                   IsAuthorized="{Binding IsAuthorized, RelativeSource={RelativeSource TemplatedParent}}" Command="{Binding EditTimeCommand, RelativeSource={RelativeSource TemplatedParent}}" />
            <local:HM11_ValueDisplay x:Name="ResultField" Grid.Row="0" Grid.Column="3" Margin="{StaticResource Inset.XS}"
                                     NumberValue="{Binding Result, RelativeSource={RelativeSource TemplatedParent}}" Unit="°" Decimals="0" Presentation="Field" />
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="{StaticResource Inset.XS}">
              <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Text="{Binding EncoderName, RelativeSource={RelativeSource TemplatedParent}}" />
              <StackPanel x:Name="PendingMark" Orientation="Horizontal" Visibility="Collapsed" Margin="{StaticResource Inset.S}">
                <Viewbox Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                  <Path Style="{StaticResource HM24.IconPath}" Data="{StaticResource Icon.State.Pending}" Stroke="{DynamicResource Brush.Status.Warning.Fg}" />
                </Viewbox>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.XS}" VerticalAlignment="Center" Text="{res:Loc HM24_Pending_Text}" />
              </StackPanel>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Angle" Value="{x:Null}">
              <Setter TargetName="AngleField" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="Time" Value="{x:Null}">
              <Setter TargetName="TimeField" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="Result" Value="{x:Null}">
              <Setter TargetName="ResultField" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsPendingWrite" Value="True">
              <Setter TargetName="PendingMark" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
