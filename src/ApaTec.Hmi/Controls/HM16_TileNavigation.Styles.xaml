<?xml version="1.0" encoding="utf-8"?>
<!-- HM-16 Kachel-Navigation: Raster (UniformGrid, Spalten/Zeilen als Parameter) aus Kacheln; Kachel = HM16_TileStyle auf Button, DataContext ist TileItem.
     Hoehe Size.Touch.Large (Small: Size.Touch.Default), Abstand Size.Touch.Gap (je Kachel Inset.S). Zustaende: Normal, Gedrueckt (Border.Medium), Leer/Reserviert (gestrichelt + Text),
     Deaktiviert mit Grund (gestrichelt, Icon.Block, Text „Nicht verfuegbar“, bleibt antippbar), Berechtigung (Icon.Key oben rechts), Warnaktion (Icon.Status.Warning), Navigationsanzeiger (Icon.Chevron). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <BooleanToVisibilityConverter x:Key="HM16_BoolToVisibility" />

  <Style x:Key="HM16_IconPath" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{Binding Source={StaticResource Border.Medium}, Path=Left}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>

  <!-- Kachel (HM16_Tile) -->
  <Style x:Key="HM16_TileStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Button.Normal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Large}" />
    <Setter Property="Margin" Value="{StaticResource Inset.S}" />
    <Setter Property="Padding" Value="{StaticResource Inset.S}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Face"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Control}"
                    Padding="{TemplateBinding Padding}">
              <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Viewbox x:Name="IconBox" Width="{StaticResource Size.Icon.L}" Height="{StaticResource Size.Icon.L}" HorizontalAlignment="Center">
                    <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                      <Path Style="{StaticResource HM16_IconPath}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                            Data="{Binding Icon}" />
                    </Grid>
                  </Viewbox>
                  <TextBlock x:Name="LabelText" Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                  <TextBlock x:Name="ReservedText" Text="{res:Loc HM16_Reserved_Text}" TextAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                  <TextBlock x:Name="UnavailableText" Text="{res:Loc HM16_Unavailable_Text}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Disabled}" TextAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <!-- Berechtigung: Schluessel oben rechts -->
                <Viewbox x:Name="KeyIcon" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                  <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                    <Path Style="{StaticResource HM16_IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" Data="{StaticResource Icon.Key}" />
                  </Grid>
                </Viewbox>
                <!-- Warnaktion: Warnsymbol oben links -->
                <Viewbox x:Name="WarningIcon" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                  <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                    <Path Style="{StaticResource HM16_IconPath}" Stroke="{DynamicResource Brush.Status.Warning.Fg}" Data="{StaticResource Icon.Status.Warning}" />
                  </Grid>
                </Viewbox>
                <!-- Deaktiviert mit Grund: Sperrsymbol oben links -->
                <Viewbox x:Name="BlockIcon" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                  <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                    <Path Style="{StaticResource HM16_IconPath}" Stroke="{DynamicResource Brush.Text.Disabled}" Data="{StaticResource Icon.Block}" />
                  </Grid>
                </Viewbox>
                <!-- Navigationsanzeiger unten rechts -->
                <Viewbox x:Name="Chevron" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}"
                         Visibility="{Binding ShowNavigationIndicator, RelativeSource={RelativeSource AncestorType={x:Type local:HM16_TileNavigation}}, Converter={StaticResource HM16_BoolToVisibility}}">
                  <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                    <Path Style="{StaticResource HM16_IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" Data="{StaticResource Icon.Chevron}" />
                  </Grid>
                </Viewbox>
              </Grid>
            </Border>
            <Rectangle x:Name="DisabledDash" Visibility="Collapsed"
                       RadiusX="{StaticResource Radius.Control.Size}" RadiusY="{StaticResource Radius.Control.Size}"
                       Stroke="{DynamicResource Brush.Border.Control}"
                       StrokeThickness="{StaticResource Border.Thin.Size}"
                       StrokeDashArray="{StaticResource Border.Dash}" />
            <Border x:Name="FocusRing" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                    BorderThickness="{StaticResource Border.Thick}"
                    CornerRadius="{StaticResource Radius.Control}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Pressed}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Disabled}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="DisabledDash" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
              <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RequiresPermission}" Value="True">
              <Setter TargetName="KeyIcon" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsWarning}" Value="True">
              <Setter TargetName="WarningIcon" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!-- Leer: Reserviert, deaktiviert, gestrichelt -->
            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="KeyIcon" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="ReservedText" Property="Visibility" Value="Visible" />
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Disabled}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="DisabledDash" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </DataTrigger>
            <!-- Deaktiviert mit Grund -->
            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
              <Setter TargetName="BlockIcon" Property="Visibility" Value="Visible" />
              <Setter TargetName="WarningIcon" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="UnavailableText" Property="Visibility" Value="Visible" />
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Disabled}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="DisabledDash" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- Leere Kachel: nicht bedienbar -->
      <DataTrigger Binding="{Binding IsEmpty}" Value="True">
        <Setter Property="IsEnabled" Value="False" />
      </DataTrigger>
      <!-- kleine Kachel -->
      <DataTrigger Binding="{Binding TileSize, RelativeSource={RelativeSource AncestorType={x:Type local:HM16_TileNavigation}}}" Value="Small">
        <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Default}" />
      </DataTrigger>
      <!-- leere Kacheln ausgeblendet, Zelle bleibt belegt -->
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsEmpty}" Value="True" />
          <Condition Binding="{Binding EmptyTileMode, RelativeSource={RelativeSource AncestorType={x:Type local:HM16_TileNavigation}}}" Value="Hidden" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Visibility" Value="Hidden" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Elementart Navigation -->
  <DataTemplate x:Key="HM16_NavTileTemplate" DataType="{x:Type local:TileItem}">
    <Button Style="{StaticResource HM16_TileStyle}"
            Command="{Binding NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type local:HM16_TileNavigation}}}"
            CommandParameter="{Binding}" />
  </DataTemplate>

  <!-- Elementart StateToggle: jede Zelle traegt ein HM-08 (TileItem.Content) -->
  <DataTemplate x:Key="HM16_ToggleCellTemplate" DataType="{x:Type local:TileItem}">
    <ContentPresenter Content="{Binding Content}" Margin="{StaticResource Inset.S}" />
  </DataTemplate>

  <Style TargetType="{x:Type local:HM16_TileNavigation}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM16_TileNavigation}">
          <ItemsControl x:Name="Tiles"
                        IsTabStop="False" Focusable="False"
                        ItemsSource="{TemplateBinding Items}"
                        ItemTemplate="{StaticResource HM16_NavTileTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType={x:Type local:HM16_TileNavigation}}}"
                             Rows="{Binding Rows, RelativeSource={RelativeSource AncestorType={x:Type local:HM16_TileNavigation}}}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <ControlTemplate.Triggers>
            <Trigger Property="ItemKind" Value="StateToggle">
              <Setter TargetName="Tiles" Property="ItemTemplate" Value="{StaticResource HM16_ToggleCellTemplate}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
