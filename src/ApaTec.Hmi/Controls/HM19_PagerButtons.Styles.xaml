<?xml version="1.0" encoding="utf-8"?>
<!-- HM-19 Blaettertasten (Layout DockPanel: Zurueck links/oben, Vor rechts/unten, Mittelfeld fuellt; Placement Flanking: Tasten links und rechts um CenterContent, ohne Positionsanzeige;
     IsCyclic: Pfeiltasten am Rand nicht nach Index gesperrt, das Umlaufen leistet der Befehl; PreviousOnly/NextOnly: einzelne Pfeiltaste fuer die Funktionsleiste HM-06): Paar Pfeiltasten (Size.Touch.Default x Size.Touch.Default) mit Positionsanzeige „n von m“ bzw. „n–m von k“ (zweiter Kanal), optionalem Mittelfeld,
     senkrechter Variante und Einzeltaste (doppelter Icon.Chevron). Am Rand: Taste deaktiviert (gestrichelt, Basisvorlage Button) ueber CanExecute der Befehle. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <local:HM19_IndexToNumberConverter x:Key="HM19_IndexToNumberConverter" />
  <local:HM19_EdgeEnabledConverter x:Key="HM19_EdgeEnabledConverter" />

  <Style x:Key="HM19_IconPath" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Size.Icon.Stroke}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>

  <Style x:Key="HM19_ArrowButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="Height" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="Margin" Value="{StaticResource Inset.S}" />
    <Setter Property="Padding" Value="{StaticResource Inset.XS}" />
  </Style>

  <Style TargetType="{x:Type local:HM19_PagerButtons}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM19_PagerButtons}">
          <DockPanel x:Name="Layout" LastChildFill="True">
            <Button x:Name="PreviousButton"
                    DockPanel.Dock="Left"
                    Style="{StaticResource HM19_ArrowButtonStyle}"
                    Command="{TemplateBinding PreviousCommand}"
                    AutomationProperties.Name="{res:Loc HM19_Previous_Name}">
              <Button.IsEnabled>
                <MultiBinding Converter="{StaticResource HM19_EdgeEnabledConverter}" ConverterParameter="Previous">
                  <Binding Path="CurrentIndex" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="Count" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="IsCyclic" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </Button.IsEnabled>
              <Viewbox x:Name="PreviousIcon" Width="{StaticResource Size.Icon.L}" Height="{StaticResource Size.Icon.L}" RenderTransformOrigin="0.5,0.5">
                <Viewbox.RenderTransform>
                  <ScaleTransform ScaleX="-1" />
                </Viewbox.RenderTransform>
                <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                  <Path Style="{StaticResource HM19_IconPath}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Data="{StaticResource Icon.Chevron}" />
                </Grid>
              </Viewbox>
            </Button>

            <Button x:Name="NextButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource HM19_ArrowButtonStyle}"
                    Command="{TemplateBinding NextCommand}"
                    AutomationProperties.Name="{res:Loc HM19_Next_Name}">
              <Button.IsEnabled>
                <MultiBinding Converter="{StaticResource HM19_EdgeEnabledConverter}" ConverterParameter="Next">
                  <Binding Path="CurrentIndex" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="Count" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="IsCyclic" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </Button.IsEnabled>
              <Viewbox x:Name="NextIcon" Width="{StaticResource Size.Icon.L}" Height="{StaticResource Size.Icon.L}" RenderTransformOrigin="0.5,0.5">
                <Grid Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}">
                  <Path x:Name="NextChevron" Style="{StaticResource HM19_IconPath}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Data="{StaticResource Icon.Chevron}" />
                  <Path x:Name="NextChevronSecond" Visibility="Collapsed" Style="{StaticResource HM19_IconPath}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Data="{StaticResource Icon.Chevron}">
                    <Path.RenderTransform>
                      <TranslateTransform X="6" />
                    </Path.RenderTransform>
                  </Path>
                </Grid>
              </Viewbox>
            </Button>
            <!-- Mittelfeld, Objektname und Positionsanzeige -->
            <StackPanel x:Name="Middle" Margin="{StaticResource Inset.S}" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ContentPresenter x:Name="CenterPresenter" Content="{TemplateBinding CenterContent}" HorizontalAlignment="Center" />
              <TextBlock x:Name="LabelText" Style="{StaticResource Text.Caption}" Text="{TemplateBinding CurrentLabel}" TextAlignment="Center" HorizontalAlignment="Center" />
              <TextBlock x:Name="PositionSingle" Style="{StaticResource Text.Body}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="NoWrap">
                <Run Text="{Binding CurrentIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={StaticResource HM19_IndexToNumberConverter}}" />
                <Run Text="{res:Loc HM19_Of_Text}" />
                <Run Text="{Binding Count, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
              </TextBlock>
              <TextBlock x:Name="PositionRange" Style="{StaticResource Text.Body}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="NoWrap" Visibility="Collapsed">
                <Run Text="{Binding RangeStart, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                <Run Text="{res:Loc HM19_RangeDash_Text}" />
                <Run Text="{Binding RangeEnd, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                <Run Text="{res:Loc HM19_Of_Text}" />
                <Run Text="{Binding Count, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>

          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="CurrentLabel" Value="{x:Null}">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="PositionMode" Value="Range">
              <Setter TargetName="PositionSingle" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PositionRange" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- senkrecht: Pfeile oben und unten -->
            <Trigger Property="Orientation" Value="Vertical">
              <Setter TargetName="PreviousButton" Property="DockPanel.Dock" Value="Top" />
              <Setter TargetName="NextButton" Property="DockPanel.Dock" Value="Bottom" />
              <Setter TargetName="PreviousIcon" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="-90" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="NextIcon" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="90" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <!-- Flanking: Tasten links und rechts um das Feld (CenterContent fuellt die Mitte), die Positionsanzeige entfaellt -->
            <Trigger Property="Placement" Value="Flanking">
              <Setter TargetName="PositionSingle" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PositionRange" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Middle" Property="HorizontalAlignment" Value="Stretch" />
              <Setter TargetName="CenterPresenter" Property="HorizontalAlignment" Value="Stretch" />
            </Trigger>
            <!-- Funktionsleiste (HM-06): einzelne Pfeiltaste zurueck bzw. vor -->
            <Trigger Property="PagerStyle" Value="PreviousOnly">
              <Setter TargetName="NextButton" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Middle" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="PagerStyle" Value="NextOnly">
              <Setter TargetName="PreviousButton" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Middle" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- Einzeltaste »: nur vorwaerts, doppeltes Chevron, keine Positionsanzeige -->
            <Trigger Property="PagerStyle" Value="Single">
              <Setter TargetName="PreviousButton" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Middle" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="NextChevronSecond" Property="Visibility" Value="Visible" />
              <Setter TargetName="NextChevron" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform X="-6" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
