<?xml version="1.0" encoding="utf-8"?>
<!-- HM34_DriveStatusRow.Styles.xaml: Template der Motor-Statuszeile (HM-34), Komposit aus HM-11 (Anzeigewerte, Max ruecksetzbar), HM-12 (Limit) und Meldungstext. Keine Logik. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Symbolpfad im 24er-Raster; Strichstaerke aus dem Token Border.Medium -->
  <Style x:Key="HM34.Icon" TargetType="Path">
    <Setter Property="Width" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="Height" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Size.Icon.Stroke}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style TargetType="{x:Type local:HM34_DriveStatusRow}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM34_DriveStatusRow}">
          <!-- Standard = Fehlerdarstellung (Meldung vorhanden); Trigger Message = null schaltet auf Normal -->
          <Border x:Name="Row"
                  Background="{DynamicResource Brush.Status.Error.Subtle}"
                  BorderBrush="{DynamicResource Brush.Divider}"
                  BorderThickness="{StaticResource Border.Thin}"
                  Padding="{StaticResource Inset.S}">
            <Grid>
              <!-- zwei Zeilen (S-03, B-32): Antrieb und Meldung oben, darunter vier Felder mit Beschriftung ueber dem Feld -->
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.Value}" VerticalAlignment="Center"
                         Margin="{StaticResource Inset.XS}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         Text="{TemplateBinding DriveName}" />
              <!-- Meldung: Symbol und Text (zweiter Kanal fuer den Fehlerzustand) -->
              <StackPanel x:Name="MessagePanel" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center"
                          Margin="{StaticResource Inset.XS}">
                <Path Style="{StaticResource HM34.Icon}"
                      Data="{StaticResource Icon.Status.Error}"
                      Stroke="{DynamicResource Brush.Status.Error.Fg}" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="{StaticResource Inset.S}"
                           VerticalAlignment="Center"
                           Text="{TemplateBinding Message}" />
              </StackPanel>
              <local:HM11_ValueDisplay Grid.Row="1" Grid.Column="0" Margin="{StaticResource Inset.XS}" FieldLabelPlacement="Top"
                                       Label="{res:Loc HM34_DiagCode_Label}"
                                       ValueKind="Number" Decimals="0"
                                       NumberValue="{Binding DiagCode, RelativeSource={RelativeSource TemplatedParent}}" />
              <local:HM11_ValueDisplay Grid.Row="1" Grid.Column="1" Margin="{StaticResource Inset.XS}" FieldLabelPlacement="Top"
                                       Label="{res:Loc HM34_CurrentActual_Label}"
                                       ValueKind="Number" Decimals="1"
                                       Unit="{res:Loc HM34_Percent_Unit}"
                                       NumberValue="{Binding CurrentActual, RelativeSource={RelativeSource TemplatedParent}}" />
              <!-- Strom max: Antippen setzt zurueck (HM-11 mit ResetCommand, Symbol Icon.Action.Reset im Feld) -->
              <local:HM11_ValueDisplay Grid.Row="1" Grid.Column="2" Margin="{StaticResource Inset.XS}" FieldLabelPlacement="Top"
                                       Label="{res:Loc HM34_CurrentMax_Label}"
                                       ValueKind="Number" Decimals="1"
                                       Unit="{res:Loc HM34_Percent_Unit}"
                                       NumberValue="{Binding CurrentMax, RelativeSource={RelativeSource TemplatedParent}}"
                                       ResetCommand="{TemplateBinding ResetMaxCommand}" />
              <!-- Strom Limit: Eingabe mit Schluessel (gesperrt: Schloss aus HM-12) -->
              <local:HM12_ValueInput Grid.Row="1" Grid.Column="3" Margin="{StaticResource Inset.XS}" FieldLabelPlacement="Top"
                                     Label="{res:Loc HM34_CurrentLimit_Label}"
                                     InputKind="Number" Decimals="1"
                                     Unit="{res:Loc HM34_Percent_Unit}"
                                     RequiresPermission="True"
                                     Command="{TemplateBinding LimitCommand}"
                                     IsAuthorized="{Binding IsLimitAuthorized, RelativeSource={RelativeSource TemplatedParent}}"
                                     NumberValue="{Binding CurrentLimit, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Message" Value="{x:Null}">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Surface}" />
              <Setter TargetName="MessagePanel" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
