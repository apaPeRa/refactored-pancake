<?xml version="1.0" encoding="utf-8"?>
<!-- HM32_PackRegisterGraphic.Styles.xaml: Template der Packungsregister-Grafik (HM-32): Canvas-Layout der Stationsfelder im horizontalen Bildlauf, Legende HM32_Legend als feste Leiste. Keine Logik. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Symbolpfad im 24er-Raster; Strichstaerke aus dem Token Border.Medium -->
  <Style x:Key="HM32.Icon" TargetType="Path">
    <Setter Property="Width" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="Height" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Size.Icon.Stroke}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Stationsfeld: Nummer, Symbol und Wort (zweiter Kanal), Kontur nach Zustand; gedrueckt Brush.Button.Pressed mit Border.Medium -->
  <Style x:Key="HM32_StationButton" TargetType="Button">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.Touch.Large}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Number}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Face"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Control}"
                    BorderThickness="{StaticResource Border.Thin}"
                    CornerRadius="{StaticResource Radius.Control}"
                    Padding="{StaticResource Inset.XS}">
              <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                             FontWeight="{StaticResource Font.Weight.Strong}"
                             Foreground="{DynamicResource Brush.Text.Primary}"
                             Text="{Binding Number}" />
                  <Path x:Name="StateIcon" Style="{StaticResource HM32.Icon}" Margin="{StaticResource Inset.S}"
                        Data="{StaticResource Icon.Status.Inactive}"
                        Stroke="{DynamicResource Brush.Status.Inactive.Fg}" />
                </StackPanel>
                <TextBlock x:Name="StateWord" Grid.Row="1" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                           Text="{res:Loc HM32_StateNone_Text}" />
              </Grid>
            </Border>
            <Border x:Name="FocusRing" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                    BorderThickness="{StaticResource Border.Thick}"
                    CornerRadius="{StaticResource Radius.Control}" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Present">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
              <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource Icon.Pack.Present}" />
              <Setter TargetName="StateIcon" Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
              <Setter TargetName="StateWord" Property="Text" Value="{res:Loc HM32_StatePresent_Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Filled">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Surface}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Status.Info.Fg}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
              <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource Icon.Pack.Filled}" />
              <Setter TargetName="StateIcon" Property="Stroke" Value="{DynamicResource Brush.Status.Info.Fg}" />
              <Setter TargetName="StateWord" Property="Text" Value="{res:Loc HM32_StateFilled_Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Ok">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Surface}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Status.Ok.Fg}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
              <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource Icon.Status.Ok}" />
              <Setter TargetName="StateIcon" Property="Stroke" Value="{DynamicResource Brush.Status.Ok.Fg}" />
              <Setter TargetName="StateWord" Property="Text" Value="{res:Loc HM32_StateOk_Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Bad">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Status.Error.Subtle}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Status.Error.Fg}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Thick}" />
              <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource Icon.Status.Error}" />
              <Setter TargetName="StateIcon" Property="Stroke" Value="{DynamicResource Brush.Status.Error.Fg}" />
              <Setter TargetName="StateWord" Property="Text" Value="{res:Loc HM32_StateBad_Text}" />
            </DataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Pressed}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:HM32_PackRegisterGraphic}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM32_PackRegisterGraphic}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Bildlaufbereich: horizontales Scrollen -->
            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly">
              <ItemsControl Focusable="False" ItemsSource="{TemplateBinding Stations}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas Width="{Binding LayoutWidth, RelativeSource={RelativeSource AncestorType={x:Type local:HM32_PackRegisterGraphic}}}"
                            Height="{Binding LayoutHeight, RelativeSource={RelativeSource AncestorType={x:Type local:HM32_PackRegisterGraphic}}}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:PackStation}">
                    <Button Style="{StaticResource HM32_StationButton}"
                            Command="{Binding ToggleStationCommand, RelativeSource={RelativeSource AncestorType={x:Type local:HM32_PackRegisterGraphic}}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <!-- HM32_Legend: feste Leiste, scrollt nicht mit -->
            <Border x:Name="Legend" Grid.Row="1"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Divider}"
                    BorderThickness="{StaticResource Border.Thin}"
                    Padding="{StaticResource Inset.S}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="{StaticResource Inset.S}">
          <Path Style="{StaticResource HM32.Icon}" Data="{StaticResource Icon.Status.Inactive}" Stroke="{DynamicResource Brush.Status.Inactive.Fg}" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center" Text="{res:Loc HM32_StateNone_Text}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="{StaticResource Inset.S}">
          <Path Style="{StaticResource HM32.Icon}" Data="{StaticResource Icon.Pack.Present}" Stroke="{DynamicResource Brush.Text.Primary}" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center" Text="{res:Loc HM32_StatePresent_Text}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="{StaticResource Inset.S}">
          <Path Style="{StaticResource HM32.Icon}" Data="{StaticResource Icon.Pack.Filled}" Stroke="{DynamicResource Brush.Status.Info.Fg}" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center" Text="{res:Loc HM32_StateFilled_Text}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="{StaticResource Inset.S}">
          <Path Style="{StaticResource HM32.Icon}" Data="{StaticResource Icon.Status.Ok}" Stroke="{DynamicResource Brush.Status.Ok.Fg}" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center" Text="{res:Loc HM32_StateOk_Text}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="{StaticResource Inset.S}">
          <Path Style="{StaticResource HM32.Icon}" Data="{StaticResource Icon.Status.Error}" Stroke="{DynamicResource Brush.Status.Error.Fg}" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Inset.S}" VerticalAlignment="Center" Text="{res:Loc HM32_StateBad_Text}" />
        </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ShowLegend" Value="False">
              <Setter TargetName="Legend" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
