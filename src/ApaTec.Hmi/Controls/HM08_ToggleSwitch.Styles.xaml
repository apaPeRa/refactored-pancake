<?xml version="1.0" encoding="utf-8"?>
<!-- HM-08 Zustandstaste / Umschalter: Stil und ControlTemplate fuer HM08_ToggleSwitch (ToggleButton). Eine Vorlage, zwei Darstellungen (ToggleStyle Switch/Button, ButtonSize Tile).
     Zustaende Aus, Ein (neutral, nicht gruen), Gedrueckt, Teilweise, Ausstehend, Fehler, Deaktiviert, Berechtigung; zweiter Kanal Knopfposition/Symbol und Wort (HM-08). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <local:HM08_HasTextConverter x:Key="HM08.HasText" />

  <Style x:Key="HM08.Icon" TargetType="Path">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="Height" Value="{StaticResource Size.Icon.S}" />
    <Setter Property="StrokeThickness" Value="{Binding Source={StaticResource Border.Medium}, Path=Left}" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Zustandswort: leere Texte (OnText, OffText, PartialText) zeigen die Standardwoerter der Ressourcen; Reihenfolge der Trigger = Prioritaet -->
  <Style x:Key="HM08.Word" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Text" Value="{Binding OffText, RelativeSource={RelativeSource TemplatedParent}}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding OffText, RelativeSource={RelativeSource TemplatedParent}}" Value="">
        <Setter Property="Text" Value="{res:Loc State_Off_Word}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
        <Setter Property="Text" Value="{Binding OnText, RelativeSource={RelativeSource TemplatedParent}}" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
          <Condition Binding="{Binding OnText, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Text" Value="{res:Loc State_On_Word}" />
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
        <Setter Property="Text" Value="{Binding PartialText, RelativeSource={RelativeSource TemplatedParent}}" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}" />
          <Condition Binding="{Binding PartialText, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Text" Value="{res:Loc HM08_Partial_Word}" />
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding IsPending, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
        <Setter Property="Text" Value="{res:Loc HM08_Pending_Text}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ErrorText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HM08.HasText}}" Value="True">
        <Setter Property="Text" Value="{Binding ErrorText, RelativeSource={RelativeSource TemplatedParent}}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type local:HM08_ToggleSwitch}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}" />
    <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Regular}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Button.Normal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="Padding" Value="{StaticResource Inset.Button}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Command" Value="{Binding ToggleCommand, RelativeSource={RelativeSource Self}}" />
    <Setter Property="CommandParameter" Value="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM08_ToggleSwitch}">
          <Grid>
            <Border x:Name="Face"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Control}"
                    Padding="{TemplateBinding Padding}">
              <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Fachsymbol (optional) -->
                <Path x:Name="IconPath"
                      Grid.Column="0"
                      Style="{StaticResource HM08.Icon}"
                      Data="{TemplateBinding Icon}"
                      Stroke="{TemplateBinding Foreground}"
                      Margin="{StaticResource Inset.XS}" />
                <!-- Beschriftung links, Berechtigungssymbol hinter der Beschriftung -->
                <Grid Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="LabelText"
                             Text="{TemplateBinding Label}"
                             Foreground="{TemplateBinding Foreground}"
                             FontFamily="{TemplateBinding FontFamily}"
                             FontSize="{TemplateBinding FontSize}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                  <Path x:Name="KeyIcon"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Style="{StaticResource HM08.Icon}"
                        Data="{StaticResource Icon.Key}"
                        Stroke="{DynamicResource Brush.Text.Primary}"
                        Margin="{StaticResource Inset.XS}" />
                  <Path x:Name="LockIcon"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        Style="{StaticResource HM08.Icon}"
                        Data="{StaticResource Icon.Lock}"
                        Stroke="{DynamicResource Brush.Text.Primary}"
                        ToolTip="{res:Loc HM08_PermissionRequired_Hint}"
                        Margin="{StaticResource Inset.XS}" />
                </Grid>
                <!-- Schalterbahn 96 x 48 mit Knopf 40 (nur Darstellung Switch) -->
                <Grid x:Name="TrackHost"
                      Grid.Column="2"
                      Visibility="Collapsed"
                      Width="{StaticResource Size.Toggle.Width}"
                      Height="{StaticResource Size.Toggle.Height}"
                      VerticalAlignment="Center"
                      Margin="{StaticResource Inset.S}">
                  <Border x:Name="Track"
                          Background="{DynamicResource Brush.Button.Normal}"
                          BorderBrush="{DynamicResource Brush.Border.Control}"
                          BorderThickness="{StaticResource Border.Thin}"
                          CornerRadius="{StaticResource Radius.Control}" />
                  <Border x:Name="Knob"
                          Width="{StaticResource Size.Toggle.Knob}"
                          Height="{StaticResource Size.Toggle.Knob}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="{StaticResource Inset.XS}"
                          Background="{DynamicResource Brush.Text.Secondary}"
                          CornerRadius="{StaticResource Radius.Pill}" />
                </Grid>
                <!-- Zweiter Kanal: Zustandssymbol und Wort -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <Path x:Name="StateIcon"
                        Style="{StaticResource HM08.Icon}"
                        Data="{StaticResource Icon.State.Off}"
                        Stroke="{TemplateBinding Foreground}"
                        Margin="{StaticResource Inset.XS}" />
                  <TextBlock x:Name="WordText"
                             Style="{StaticResource HM08.Word}"
                             Foreground="{TemplateBinding Foreground}"
                             FontFamily="{TemplateBinding FontFamily}"
                             MinWidth="{StaticResource Size.Touch.Min}" />
                </StackPanel>
              </Grid>
            </Border>
            <!-- Zweiter Kanal Ausstehend / Deaktiviert: gestrichelte Kontur -->
            <Rectangle x:Name="DashOverlay"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"
                       RadiusX="{StaticResource Radius.Control.Size}" RadiusY="{StaticResource Radius.Control.Size}"
                       Stroke="{DynamicResource Brush.Border.Control}"
                       StrokeThickness="{StaticResource Border.Thin.Size}"
                       StrokeDashArray="{StaticResource Border.Dash}" />
            <Border x:Name="FocusRing"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                    BorderThickness="{StaticResource Border.Thick}"
                    CornerRadius="{StaticResource Radius.Control}" />
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Darstellung Switch: Flaeche transparent, Bahn sichtbar (Rand bleibt fuer den Fehlerzustand reserviert, kein Layoutsprung) -->
            <Trigger Property="ToggleStyle" Value="Switch">
              <Setter TargetName="Face" Property="Background" Value="Transparent" />
              <Setter TargetName="Face" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Thick}" />
              <Setter TargetName="TrackHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ToggleStyle" Value="Button" />
                <Condition Property="ButtonSize" Value="Tile" />
              </MultiTrigger.Conditions>
              <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Large}" />
            </MultiTrigger>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- Ein: Knopf rechts, Bahn gefuellt (neutral), Symbol Haken und Wort -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Button.Active}" />
              <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.Text.OnActive}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource Icon.State.On}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ToggleStyle" Value="Button" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Active}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnActive}" />
            </MultiTrigger>
            <!-- Teilweise (Sammelzustand): Knopf Mitte, Kontur 2 px, Symbol Strich im Kreis und Wort -->
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Track" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Center" />
              <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource Icon.State.Partial}" />
            </Trigger>
            <!-- Ausstehend: Zustand wie Soll, Kontur gestrichelt, Symbol und Text -->
            <Trigger Property="IsPending" Value="True">
              <Setter TargetName="DashOverlay" Property="Visibility" Value="Visible" />
              <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource Icon.State.Pending}" />
            </Trigger>
            <!-- Fehler: Kontur 3 px Fehlerfarbe, Flaeche Subtle, Symbol und Fehlertext -->
            <DataTrigger Binding="{Binding ErrorText, RelativeSource={RelativeSource Self}, Converter={StaticResource HM08.HasText}}" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Status.Error.Subtle}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Status.Error.Fg}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Thick}" />
              <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource Icon.Status.Error}" />
              <Setter TargetName="StateIcon" Property="Stroke" Value="{DynamicResource Brush.Status.Error.Fg}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </DataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Pressed}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="RequiresPermission" Value="True" />
                <Condition Property="IsAuthorized" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="KeyIcon" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="RequiresPermission" Value="True" />
                <Condition Property="IsAuthorized" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="LockIcon" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ToggleStyle" Value="Button" />
                <Condition Property="IsEnabled" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Disabled}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="Transparent" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="DashOverlay" Property="Visibility" Value="Visible" />
              <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.Text.Disabled}" />
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Button.Disabled}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
