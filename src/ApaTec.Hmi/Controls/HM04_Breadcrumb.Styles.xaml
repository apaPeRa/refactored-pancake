<?xml version="1.0" encoding="utf-8"?>
<!-- HM-04 Brotkruemel-Navigation (HM04_Breadcrumb): Segmente Hoehe Size.Touch.Default auf Brush.Surface.Sunken, Kontur Border.Thin, Trenner Icon.Chevron (Pfeilform).
     Aktuelles Segment (letztes): Fettschrift, nicht antippbar. Gedrueckt: Brush.Button.Pressed mit Border.Medium. Nicht navigierbar/gesperrt: gestrichelte Kontur.
     Gesperrt hinter Pop-ups: IsEnabled = false (Navigation.md 4.2). Kuerzen auf "..." bei mehr als fuenf Segmenten liefert der Navigationsdienst. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:nav="clr-namespace:ApaTec.Hmi.Navigation"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">

  <Style x:Key="HM04_SegmentButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Default}" />
    <Setter Property="Padding" Value="{StaticResource Inset.Button}" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Face"
                    Background="{DynamicResource Brush.Surface.Sunken}"
                    BorderBrush="{DynamicResource Brush.Border.Control}"
                    BorderThickness="{StaticResource Border.Thin}"
                    CornerRadius="{StaticResource Radius.Control}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Rectangle x:Name="DisabledDash" Visibility="Collapsed"
                       RadiusX="{StaticResource Radius.Control.Size}" RadiusY="{StaticResource Radius.Control.Size}"
                       Stroke="{DynamicResource Brush.Border.Control}"
                       StrokeThickness="{StaticResource Border.Thin.Size}"
                       StrokeDashArray="{StaticResource Border.Dash}" />
            <Border x:Name="FocusRing" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Brush.Border.Focus}"
                    BorderThickness="{StaticResource Border.Thick}"
                    CornerRadius="{StaticResource Radius.Control}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Button.Pressed}" />
              <Setter TargetName="Face" Property="BorderThickness" Value="{StaticResource Border.Medium}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="DisabledDash" Property="Visibility" Value="Visible" />
              <Setter TargetName="Face" Property="BorderBrush" Value="Transparent" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:HM04_Breadcrumb}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM04_Breadcrumb}">
          <Border Padding="{StaticResource Inset.Button}"
                  AutomationProperties.Name="{res:Loc HM04_Breadcrumb_Automation}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ItemsControl Focusable="False" ItemsSource="{TemplateBinding Segments}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type nav:BreadcrumbItem}">
                    <StackPanel Orientation="Horizontal">
                      <!-- Antippbares Segment -->
                      <Button x:Name="Segment"
                              Style="{StaticResource HM04_SegmentButton}"
                              Content="{Binding DisplayText}"
                              IsEnabled="{Binding IsNavigable}"
                              Command="{Binding NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type local:HM04_Breadcrumb}}}"
                              CommandParameter="{Binding Key}" />
                      <!-- Aktuelles Segment: Fettschrift am Ende, keine Navigation -->
                      <Border x:Name="Current" Visibility="Collapsed"
                              MinHeight="{StaticResource Size.Touch.Default}"
                              Background="{DynamicResource Brush.Surface.Sunken}"
                              BorderBrush="{DynamicResource Brush.Border.Control}"
                              BorderThickness="{StaticResource Border.Thin}"
                              CornerRadius="{StaticResource Radius.Control}"
                              Padding="{StaticResource Inset.Button}"
                              AutomationProperties.ItemStatus="current">
                        <TextBlock Style="{StaticResource Text.Body}"
                                   FontWeight="{StaticResource Font.Weight.Strong}"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center"
                                   Text="{Binding DisplayText}" />
                      </Border>
                      <!-- Trenner (Pfeilform) -->
                      <Viewbox x:Name="Separator"
                               Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}"
                               Margin="{StaticResource Inset.S}">
                        <Grid>
                          <Path Data="M0,0 H24 V24 H0 Z" Fill="Transparent" />
                          <Path Data="{StaticResource Icon.Chevron}"
                                StrokeThickness="{Binding Source={StaticResource Border.Medium}, Path=Left}"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                Stroke="{DynamicResource Brush.Text.Secondary}" />
                        </Grid>
                      </Viewbox>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="Segment" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Current" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- Objektkennung (z. B. HD1) am letzten Segment -->
              <TextBlock x:Name="SuffixText"
                         Style="{StaticResource Text.Value}"
                         TextWrapping="NoWrap"
                         VerticalAlignment="Center"
                         Margin="{StaticResource Inset.S}"
                         Text="{TemplateBinding ObjectSuffix}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ObjectSuffix" Value="">
              <Setter TargetName="SuffixText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ObjectSuffix" Value="{x:Null}">
              <Setter TargetName="SuffixText" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
