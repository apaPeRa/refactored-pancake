<?xml version="1.0" encoding="utf-8"?>
<!-- HM36_IoRow.Styles.xaml: Template der EA-Zeile (HM-36), Komposit aus HM-09 (kompakte LED). Keine Logik. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
  </ResourceDictionary.MergedDictionaries>


  <Style TargetType="{x:Type local:HM36_IoRow}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Min}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM36_IoRow}">
          <Border x:Name="Row"
                  Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Divider}"
                  BorderThickness="{StaticResource Border.Thin}"
                  Padding="{StaticResource Inset.S}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="13*" />
              </Grid.ColumnDefinitions>
              <!-- Digital: kompakte Status-LED (Symbol und Wort aus HM-09, auch Unbekannt mit gestrichelter Kontur); Analog: Zahlenwert -->
              <Grid Grid.Column="0" VerticalAlignment="Center">
                <local:HM09_StatusLed x:Name="Led" IsCompact="True" ShowStateWord="True"
                                      State="{Binding State, RelativeSource={RelativeSource TemplatedParent}}" />
                <Grid x:Name="AnalogArea" Visibility="Collapsed">
                  <TextBlock x:Name="AnalogValue" Style="{StaticResource Text.Value}"
                             Text="{Binding AnalogValue, RelativeSource={RelativeSource TemplatedParent}, StringFormat=N1}" />
                  <TextBlock x:Name="AnalogUnknown" Style="{StaticResource Text.Value}" Visibility="Collapsed"
                             Text="{res:Loc HM36_Unknown_Value}" />
                </Grid>
              </Grid>
              <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                         Margin="{StaticResource Inset.XS}"
                         Text="{TemplateBinding Identifier}" />
              <TextBlock x:Name="DescriptionText" Grid.Column="2" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                         Margin="{StaticResource Inset.XS}"
                         Text="{TemplateBinding Description}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IoKind" Value="Analog">
              <Setter TargetName="Led" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="AnalogArea" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="AnalogValue" Value="{x:Null}">
              <Setter TargetName="AnalogValue" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="AnalogUnknown" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- Reserve: Klartext in Sekundaerfarbe (zweiter Kanal: Klartext RESERVE) -->
            <Trigger Property="IsReserve" Value="True">
              <Setter TargetName="DescriptionText" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            </Trigger>
            <!-- Fehler: Zeile getoent (zweiter Kanal: Symbol Icon.Status.Error und Wort aus der LED) -->
            <Trigger Property="State" Value="Error">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Status.Error.Subtle}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
