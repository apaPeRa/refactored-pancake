<?xml version="1.0" encoding="utf-8"?>
<!-- HM-02 Kopfzeile (HM02_HeaderBar): Raster 12* : 13* : 6* : 4* (Size.Header.Col.*) = Logo, Meldezeile (HM-03), Betriebsart, Uhr/Datum.
     Betriebsart mit zweitem Kanal: Symbol + Wort; Service = Warnflaeche mit Kontur Border.Medium und Icon.Status.Warning, Stoerung = Fehlerflaeche mit Icon.Status.Error.
     Uhr: Ziffern und Datum als Anzeige; ungueltige Zeit als Text (Strich-Platzhalter). Das Format ist kulturunabhaengig (HH:mm:ss, dd.MM.yyyy). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls"
                    xmlns:res="clr-namespace:ApaTec.Hmi.Resources">

  <Style TargetType="{x:Type local:HM02_HeaderBar}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HM02_HeaderBar}">
          <Border Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Divider}"
                  BorderThickness="{StaticResource Border.Thin}"
                  AutomationProperties.Name="{res:Loc HM02_Header_Automation}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource Size.Header.Col.Logo}" />
                <ColumnDefinition Width="{StaticResource Size.Header.Col.Message}" />
                <ColumnDefinition Width="{StaticResource Size.Header.Col.Mode}" MinWidth="{StaticResource Size.Header.Mode.MinWidth}" />
                <ColumnDefinition Width="{StaticResource Size.Header.Col.Clock}" MinWidth="{StaticResource Size.Header.Clock.MinWidth}" />
              </Grid.ColumnDefinitions>

              <!-- Logo (Spalte 1): in M2 Platzhaltertext, die Grafik je Thema folgt in M3 -->
              <Grid Grid.Column="0" Margin="{StaticResource Inset.S}">
                <Image x:Name="LogoImage" Stretch="Uniform" HorizontalAlignment="Left" Source="{TemplateBinding LogoSource}" />
                <TextBlock x:Name="LogoPlaceholder" Visibility="Collapsed"
                           Style="{StaticResource Text.Title}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Text="{res:Loc HM02_Logo_Placeholder}" />
              </Grid>

              <!-- Meldezeile (Spalte 2) -->
              <local:HM03_MessageLine x:Name="MessageLine" Grid.Column="1"
                                      Margin="{StaticResource Inset.S}"
                                      Number="{TemplateBinding MessageNumber}"
                                      Text="{TemplateBinding MessageText}"
                                      Class="{TemplateBinding MessageClass}"
                                      AdditionalCount="{TemplateBinding AdditionalMessageCount}"
                                      OpenCommand="{TemplateBinding MessageCommand}" />

              <!-- Betriebsart (Spalte 3) -->
              <Border x:Name="ModeFace" Grid.Column="2"
                      Margin="{StaticResource Inset.S}"
                      Background="{DynamicResource Brush.Surface}"
                      BorderBrush="Transparent"
                      BorderThickness="{StaticResource Border.Medium}"
                      CornerRadius="{StaticResource Radius.Control}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Viewbox Width="{StaticResource Size.Icon.L}" Height="{StaticResource Size.Icon.L}">
                    <Grid>
                      <Path Data="M0,0 H24 V24 H0 Z" Fill="Transparent" />
                      <Path x:Name="ModeIcon"
                            Data="{StaticResource Icon.Mode.Production}"
                            StrokeThickness="{StaticResource Size.Icon.Stroke}"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Stroke="{DynamicResource Brush.Text.Primary}" />
                    </Grid>
                  </Viewbox>
                  <TextBlock x:Name="ModeText"
                             Style="{StaticResource Text.Title}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             Margin="{StaticResource Inset.S}"
                             Text="{TemplateBinding OperatingModeText}" />
                </StackPanel>
              </Border>

              <!-- Uhrzeit und Datum (Spalte 4) -->
              <Border Grid.Column="3" Margin="{StaticResource Inset.S}"
                      Background="{DynamicResource Brush.Surface.Sunken}"
                      CornerRadius="{StaticResource Radius.Control}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock x:Name="TimeSeconds" Style="{StaticResource Text.Metric}" TextWrapping="NoWrap" HorizontalAlignment="Center"
                             Text="{Binding Now, RelativeSource={RelativeSource TemplatedParent}, StringFormat=HH:mm:ss}" />
                  <TextBlock x:Name="TimeMinutes" Visibility="Collapsed" Style="{StaticResource Text.Metric}" TextWrapping="NoWrap" HorizontalAlignment="Center"
                             Text="{Binding Now, RelativeSource={RelativeSource TemplatedParent}, StringFormat=HH:mm}" />
                  <TextBlock x:Name="TimeInvalid" Visibility="Collapsed" Style="{StaticResource Text.Metric}" TextWrapping="NoWrap" HorizontalAlignment="Center"
                             Text="{res:Loc HM02_Time_Invalid}" />
                  <TextBlock x:Name="DateText" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" HorizontalAlignment="Center"
                             Text="{Binding Now, RelativeSource={RelativeSource TemplatedParent}, StringFormat=dd.MM.yyyy}" />
                  <TextBlock x:Name="DateInvalid" Visibility="Collapsed" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" HorizontalAlignment="Center"
                             Text="{res:Loc HM02_Date_Invalid}" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="LogoSource" Value="{x:Null}">
              <Setter TargetName="LogoImage" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="LogoPlaceholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="ShowMessageLine" Value="False">
              <Setter TargetName="MessageLine" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="ShowSeconds" Value="False">
              <Setter TargetName="TimeSeconds" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="TimeMinutes" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsTimeValid" Value="False">
              <Setter TargetName="TimeSeconds" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="TimeMinutes" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="DateText" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="TimeInvalid" Property="Visibility" Value="Visible" />
              <Setter TargetName="DateInvalid" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- Betriebsarten: eigenes Symbol und Wort; Service = Warnung, Stoerung = Fehler -->
            <Trigger Property="OperatingMode" Value="Setup">
              <Setter TargetName="ModeIcon" Property="Data" Value="{StaticResource Icon.Settings}" />
            </Trigger>
            <Trigger Property="OperatingMode" Value="Manual">
              <Setter TargetName="ModeIcon" Property="Data" Value="{StaticResource Icon.Manual}" />
            </Trigger>
            <Trigger Property="OperatingMode" Value="Service">
              <Setter TargetName="ModeIcon" Property="Data" Value="{StaticResource Icon.Status.Warning}" />
              <Setter TargetName="ModeIcon" Property="Stroke" Value="{DynamicResource Brush.Status.Warning.On}" />
              <Setter TargetName="ModeText" Property="Foreground" Value="{DynamicResource Brush.Status.Warning.On}" />
              <Setter TargetName="ModeFace" Property="Background" Value="{DynamicResource Brush.Status.Warning.Fill}" />
              <Setter TargetName="ModeFace" Property="BorderBrush" Value="{DynamicResource Brush.Status.Warning.Fg}" />
            </Trigger>
            <Trigger Property="OperatingMode" Value="Fault">
              <Setter TargetName="ModeIcon" Property="Data" Value="{StaticResource Icon.Status.Error}" />
              <Setter TargetName="ModeIcon" Property="Stroke" Value="{DynamicResource Brush.Status.Error.On}" />
              <Setter TargetName="ModeText" Property="Foreground" Value="{DynamicResource Brush.Status.Error.On}" />
              <Setter TargetName="ModeFace" Property="Background" Value="{DynamicResource Brush.Status.Error.Fill}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
