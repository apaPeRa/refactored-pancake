<Application x:Class="ApaTec.Hmi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nav="clr-namespace:ApaTec.Hmi.Navigation">
    <!-- Kein StartupUri: Program.Main baut den Host auf und zeigt das Hauptfenster (Composition Root).
         Reihenfolge der MergedDictionaries: Das ERSTE ist das Theme (IThemeService tauscht es aus, Designsystem 8). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Light.xaml" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.Base.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <nav:ViewLocator x:Key="ViewLocator" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
