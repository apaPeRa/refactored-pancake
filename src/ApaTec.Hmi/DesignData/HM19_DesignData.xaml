<?xml version="1.0" encoding="utf-8"?>
<!-- HM19_DesignData.xaml: Beispielinstanzen fuer den Entwurfsmodus (Designer/Vorschau), Werte aus der Moduldatei. Nicht in die Anwendung eingebunden.
     Jede Instanz ist x:Shared="False" (eigene Kopie je Verwendung). Theme: Hell. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ApaTec.Hmi.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Theme.Light.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Tokens.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Themes/Controls.Base.xaml" />
    <ResourceDictionary Source="pack://application:,,,/ApaTec.Hmi;component/Controls/HM19_PagerButtons.Styles.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Paar in der Funktionsleiste: 1 von 2 -->
  <local:HM19_PagerButtons x:Key="HM19.Sample.Pair" x:Shared="False" Count="2" CurrentIndex="0" CurrentLabel="Hauptdosierer 1" />
  <!-- Einzeltaste » -->
  <local:HM19_PagerButtons x:Key="HM19.Sample.Single" x:Shared="False" Count="2" CurrentIndex="0" PagerStyle="Single" />
  <!-- mit Mittelfeld Uebersicht (HS-25) -->
  <local:HM19_PagerButtons x:Key="HM19.Sample.Center" x:Shared="False" Count="12" CurrentIndex="2">
    <local:HM19_PagerButtons.CenterContent>
      <Button Content="Übersicht" />
    </local:HM19_PagerButtons.CenterContent>
  </local:HM19_PagerButtons>
  <!-- senkrecht mit Bereich 1-12 von 20 -->
  <local:HM19_PagerButtons x:Key="HM19.Sample.Vertical" x:Shared="False" Count="20" Orientation="Vertical"
                           PositionMode="Range" RangeStart="1" RangeEnd="12" />
</ResourceDictionary>
